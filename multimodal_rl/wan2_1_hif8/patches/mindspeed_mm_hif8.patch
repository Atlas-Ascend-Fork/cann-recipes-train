+import os
+from typing import Optional, Tuple, List
+
+import torch
+import torch.distributed as dist
+import torch_npu
+
+from megatron.training import get_args
+from megatron.training.arguments import core_transformer_config_from_args
+from mindspeed.te.pytorch.fp8.recipes import TEDelayedScaling
+from mindspeed.te.pytorch.fp8.constants import Format, FP8Format, FormatEnum
+from mindspeed.te.pytorch.fp8.tensor import Float8Tensor, is_fp8_tensor
+from mindspeed.te.pytorch.fp8.scale_data import ScaleDataFA
+
+from mindspeed_mm.utils.utils import change_tensor_layout
+
+PER_BLOCK_Q_SIZE = 128
+PER_BLOCK_KV_SIZE = 256
+FP8_MAX = 448.0
+
+def calc_scale_size(tensor, block_size):
+    if tensor.dim() != 4:
+        raise ValueError(f"Input must be 4D tensor [B, N, S, D], got shape {tensor.shape}")  
+    if block_size <= 0:
+        raise ValueError(f"block_size must be positive, got {block_size}")
+
+    B, N, S, D = tensor.shape
+    pad_len = (block_size - S % block_size) % block_size
+    S_padded = S + pad_len if pad_len > 0 else S
+
+    return torch.Size([B, N, S_padded // block_size, block_size * D])
+
+
+class FP8All2AllScaleData:
+    def __init__(self, recipe_config, fp8_format: FP8Format, scale_shape: List[int] = None):  
+        self.config = recipe_config
+        self.ori_dtype = None
+        self.scale_shape = scale_shape if scale_shape is not None else [1]
+        self.device = 'npu:{}'.format(torch.npu.current_device())
+
+        self.fp8_format: FP8Format = fp8_format
+        self.fp8_max = self.fp8_format.max
+        self.margin = self.config.config.fp8_margin if hasattr(self.config, 'config') else 0  
+        self.scale = torch.ones(self.scale_shape, device=self.device)
+
+        self.amax_history_len = self.config.config.fp8_amax_history_len if hasattr(self.config, 'config') else 1  
+        self.amax_history_current_len = 0
+        self.amax_history = torch.zeros([self.amax_history_len] + self.scale_shape, device=self.device)  
+        self.amax = torch.zeros(self.scale_shape, device=self.device)
+        self.current_interval = 1
+        self.fp8_interval = self.config.config.fp8_interval if hasattr(self.config, 'config') else 1  
+
+    def append_amax(self, amax):
+        if self.amax_history_current_len < self.amax_history_len:
+            self.amax_history[self.amax_history_current_len, :].copy_(amax, non_blocking=True) 
+            self.amax_history_current_len += 1
+        else:
+            self.amax_history = self.amax_history.roll(-1, 0)
+            self.amax_history[self.amax_history_len - 1, :].copy_(amax, non_blocking=True)  
+
+    def delayed_recipe_update_scale(self):
+        if self.amax_history_current_len < self.amax_history_len:
+            amax = self.amax_history[self.amax_history_current_len - 1, :]
+        else:
+            amax = self.amax_history[self.amax_history_len - 1, :]
+
+        if torch.any(amax == 0):
+            # 与 mindspeed 侧 ScaleDataFA 一致: 零值 amax 对应位置的 scale 复位为 1
+            one = torch.ones_like(self.scale)
+            self.scale = torch.where(amax == 0, one, self.scale)
+        else:
+            self.scale = ((amax * (2 ** self.margin)) / self.fp8_max)
+
+    def update_scale_from_amax(self, amax_value):
+        if amax_value == 0:
+            return self.scale
+        self.amax.fill_(amax_value)
+        self.append_amax(self.amax)
+        self.delayed_recipe_update_scale()
+        return self.scale
+
+    def delayed_recipe_update_amax(self, tensor, stream):
+        if self.amax_history_current_len < self.amax_history_len:
+            self.current_interval = 1
+            amax = torch.amax(torch.abs(tensor))
+            self.append_amax(amax)
+            self.delayed_recipe_update_scale()
+            scale = self.scale
+        else:
+            stream.wait_stream(torch.cuda.current_stream())
+            scale = self.scale
+
+            if self.current_interval >= self.fp8_interval:
+                self.current_interval = 1
+                with torch.cuda.stream(stream):
+                    amax = torch.amax(torch.abs(tensor))
+                    self.append_amax(amax)
+                    self.delayed_recipe_update_scale()
+            else:
+                self.current_interval += 1
+        return scale
+
+
+class FP8All2AllRecipe:
+    ALL_SCALING = []
+    MAX_STREAM = None
+
+    def __init__(self, key, recipe_config: 'TEDelayedScaling', fp8_format: FP8Format, tensor_shape=None) -> None:  
+        super().__init__()
+        if FP8All2AllRecipe.MAX_STREAM is None:
+            FP8All2AllRecipe.MAX_STREAM = torch.cuda.Stream()
+        self.scale = None
+        self.recipe_config = recipe_config
+        self.key = key
+        self.tensor_shape = tensor_shape
+        self.fp8_format = fp8_format
+        self.quant_dtype = fp8_format.quant_type
+
+        FP8All2AllRecipe.ALL_SCALING.append(self)
+        FP8All2AllRecipe.MAX_STREAM.wait_stream(torch.cuda.current_stream())
+
+    def finally_step(self):
+        torch.cuda.current_stream().wait_stream(FP8All2AllRecipe.MAX_STREAM)
+        if self.scale is not None:
+            self.scale.delayed_recipe_update_scale()
+
+    def init_scale(self):
+        if self.scale is None:
+            self.scale = FP8All2AllScaleData(self.recipe_config, self.fp8_format)  
+
+    def quantization(self, tensor, global_amax=None):
+        if tensor is None:
+            return tensor
+        if is_fp8_tensor(tensor):
+            return tensor
+
+        self.init_scale()
+
+        if global_amax is not None:
+            scale = self.scale.update_scale_from_amax(global_amax)
+        else:
+            scale = self.scale.delayed_recipe_update_amax(tensor, FP8All2AllRecipe.MAX_STREAM) 
+
+        quant_tensor = torch_npu.npu_quantize(tensor, scale, zero_points=None, dtype=self.quant_dtype, axis=-1)  
+        return Float8Tensor(quant_tensor, self.quant_dtype, scale, dtype=tensor.dtype)  
+
+
+class FP8All2AllPrequantFlashAttentionFunc(torch.autograd.Function):
+    @staticmethod
+    def forward(
+        ctx,
+        query_fp8, key_fp8, value_fp8,
+        query_scale, key_scale, value_scale,
+        head_num,
+        layout,
+        pse,
+        padding_mask,
+        atten_mask,
+        actual_seq_qlen,
+        actual_seq_kvlen,
+        scale,
+        keep_prob,
+        inner_precise,
+        sparse_mode,
+        dy_scaler
+    ):
+        query_scale_size_128 = calc_scale_size(query_fp8, block_size=128)
+        key_scale_size_256 = calc_scale_size(key_fp8, block_size=256)
+        value_scale_size_512 = calc_scale_size(value_fp8, block_size=512)
+
+        query_scale_128 = query_scale.broadcast_to((*query_scale_size_128[:-1], 1))
+        key_scale_256 = key_scale.broadcast_to((*key_scale_size_256[:-1], 1))
+        value_scale_512 = value_scale.broadcast_to((*value_scale_size_512[:-1], 1))
+
+        query_scale_size_512 = calc_scale_size(query_fp8, block_size=512)
+        key_scale_size_512 = calc_scale_size(key_fp8, block_size=512)
+        value_scale_size_512 = calc_scale_size(value_fp8, block_size=512)
+
+        query_scale_512_bw = query_scale.broadcast_to((*query_scale_size_512[:-1], 1))  
+        key_scale_512_bw = key_scale.broadcast_to((*key_scale_size_512[:-1], 1))
+        value_scale_512_bw = value_scale.broadcast_to((*value_scale_size_512[:-1], 1)) 
+
+        q_fw = query_fp8.permute(0, 2, 1, 3).contiguous()
+        k_fw = key_fp8.permute(0, 2, 1, 3).contiguous()
+        v_fw = value_fp8.permute(0, 2, 1, 3).contiguous()
+
+        p_scale_tensor_cpu = torch.ones(1, dtype=torch.float, device=torch.device('cpu')) * 15 
+        p_scale_tensor = p_scale_tensor_cpu.npu()
+
+        layout_fw = 'BSND'
+        res = torch_npu.npu_quant_fusion_attention(
+            q_fw, k_fw, v_fw, head_num, layout_fw,
+            scale=scale,
+            d_scale_q=query_scale_128,
+            d_scale_k=key_scale_256,
+            d_scale_v=value_scale_512,
+            query_dtype=torch_npu.hifloat8,
+            p_scale=p_scale_tensor
+        )
+
+        attn = res[0]
+        softmax_max = res[1]
+        softmax_sum = res[2]
+
+        ctx.save_for_backward(
+            q_fw, k_fw, v_fw,
+            attn, softmax_max, softmax_sum,
+            query_scale_512_bw, key_scale_512_bw, value_scale_512_bw
+        )
+
+        ctx.head_num = head_num
+        ctx.layout = layout
+        ctx.pse = pse
+        ctx.padding_mask = padding_mask
+        ctx.atten_mask = atten_mask
+        ctx.actual_seq_qlen = actual_seq_qlen
+        ctx.actual_seq_kvlen = actual_seq_kvlen
+        ctx.scale_value = scale
+        ctx.keep_prob = keep_prob
+        ctx.inner_precise = inner_precise
+        ctx.sparse_mode = sparse_mode
+        ctx.out_dtype = 1
+        ctx.query_dtype = torch_npu.hifloat8
+        ctx.dy_scaler = dy_scaler
+        attn_return = attn.permute(0, 2, 1, 3).contiguous()
+
+        return attn_return
+
+    @staticmethod
+    def backward(ctx, dy):
+        q, k, v, attn_in, softmax_max, softmax_sum, d_scale_q, d_scale_k, d_scale_v = ctx.saved_tensors
+
+        dy_scale_size = calc_scale_size(dy, block_size=512)
+
+        dy_fp8_512 = ctx.dy_scaler.quantization(dy, global_amax=None)
+        dy_scale_512 = dy_fp8_512.fp8_scale.broadcast_to((*dy_scale_size[:-1], 1))
+
+        head_num_bw = q.shape[2]
+        dy_bw = dy_fp8_512.data.permute(0, 2, 1, 3).contiguous()
+
+        layout_bw = 'BSND'
+
+        p_scale_tensor_cpu = torch.ones(1, dtype=torch.float, device=torch.device('cpu')) * 15
+        p_scale_tensor = p_scale_tensor_cpu.npu()
+
+        ds_scale_tensor_cpu = torch.ones(1, dtype=torch.float, device=torch.device('cpu')) * (2 ** 15)
+        ds_scale_tensor = ds_scale_tensor_cpu.npu()
+
+        res = torch_npu.npu_quant_fusion_attention_grad(
+            q,
+            k,
+            v,
+            dy_bw,
+            head_num=head_num_bw,
+            input_layout=layout_bw,
+            softmax_max=softmax_max,
+            softmax_sum=softmax_sum,
+            attention_in=attn_in,
+            scale_value=ctx.scale_value,
+            d_scale_q=d_scale_q,
+            d_scale_k=d_scale_k,
+            d_scale_v=d_scale_v,
+            d_scale_dy=dy_scale_512,
+            query_dtype=ctx.query_dtype,
+            p_scale=p_scale_tensor,
+            ds_scale=ds_scale_tensor
+        )
+
+        dq = res[0].permute(0, 2, 1, 3).contiguous()
+        dk = res[1].permute(0, 2, 1, 3).contiguous()
+        dv = res[2].permute(0, 2, 1, 3).contiguous()
+
+        return dq, dk, dv, None, None, None, None, None, None, None, None, None, None, None, None, None, None
+
+
+class FP8All2AllCommunication:
+    def __init__(self, group, enable_fp8_all2all=False):
+        self.group = group
+        self.enable_fp8_all2all = enable_fp8_all2all
+        self.world_size = dist.get_world_size(group) if group is not None else 1 
+
+        if enable_fp8_all2all and self.world_size > 1:
+            args = get_args()
+            # forward/backward recipes must hold separate config objects, otherwise the
+            # backward settings below would overwrite the forward ones on the shared config
+            fw_config = core_transformer_config_from_args(args)
+            fw_delayed_recipe = TEDelayedScaling(config=fw_config, fp8_format=Format.HIF8)
+            fw_delayed_recipe.config.fp8_amax_compute_algo = 'most_recent'
+            fw_delayed_recipe.config.fp8_amax_history_len = 1
+            fw_delayed_recipe.config.fp8_interval = 10
+
+            bw_config = core_transformer_config_from_args(args)
+            bw_delayed_recipe = TEDelayedScaling(config=bw_config, fp8_format=Format.HIF8)
+            bw_delayed_recipe.config.fp8_amax_compute_algo = 'mean'
+            bw_delayed_recipe.config.fp8_amax_history_len = 128
+            bw_delayed_recipe.config.fp8_interval = 1
+
+            fw_fp8_format = FormatEnum.HIF8_15.value
+            bw_fp8_format = FormatEnum.HIF8_224.value
+
+            self.q_recipes = [
+                FP8All2AllRecipe(key=f'q_all2all_chunk_{i}', recipe_config=fw_delayed_recipe, fp8_format=fw_fp8_format)
+                for i in range(self.world_size)
+            ]
+            self.k_recipes = [
+                FP8All2AllRecipe(key=f'k_all2all_{i}', recipe_config=fw_delayed_recipe, fp8_format=fw_fp8_format)
+                for i in range(self.world_size)
+            ]
+            self.v_recipes = [
+                FP8All2AllRecipe(key=f'v_all2all_{i}', recipe_config=fw_delayed_recipe, fp8_format=fw_fp8_format)
+                for i in range(self.world_size)
+            ]
+
+            self.dy_recipe = FP8All2AllRecipe(key='dq_all2all', recipe_config=bw_delayed_recipe, fp8_format=bw_fp8_format)
+
+    def _compute_amax_per_chunk(self, tensor: torch.Tensor, scatter_dim: int) -> torch.Tensor:
+        chunk_size = tensor.size(scatter_dim) // self.world_size
+        remainder = tensor.size(scatter_dim) % self.world_size
+
+        amax_list = []
+        start_idx = 0
+
+        for i in range(self.world_size):
+            current_chunk_size = chunk_size + (1 if i < remainder else 0)
+            chunk = tensor.narrow(scatter_dim, start_idx, current_chunk_size)
+            amax = torch.amax(torch.abs(chunk))
+            amax_list.append(amax)
+            start_idx += current_chunk_size
+
+        return torch.stack(amax_list)
+
+    def _allreduce_amax(self, amax_vector: torch.Tensor) -> torch.Tensor:
+        global_amax = amax_vector.clone()
+        dist.all_reduce(global_amax, op=dist.ReduceOp.MAX, group=self.group)
+        return global_amax
+
+    def _quantize_chunks_with_global_amax(
+        self,
+        tensor: torch.Tensor,
+        global_amax_vec: torch.Tensor,
+        recipes: List[FP8All2AllRecipe],
+        scatter_dim: int
+    ) -> Tuple[torch.Tensor, torch.Tensor]:
+        N = tensor.size(scatter_dim)
+        chunk_size = N // self.world_size
+        remainder = N % self.world_size
+
+        if remainder == 0:
+            shape = list(tensor.shape)
+            new_shape = shape[:scatter_dim] + [self.world_size, chunk_size] + shape[scatter_dim + 1:]
+            reshaped = tensor.view(*new_shape)
+
+            scales = []
+            for i in range(self.world_size):
+                recipes[i].init_scale()
+                scale = recipes[i].scale.update_scale_from_amax(global_amax_vec[i].item())
+                scales.append(scale)
+            scales_tensor = torch.stack(scales)
+
+            quant_chunks = []
+            for i in range(self.world_size):
+                chunk = reshaped.select(scatter_dim, i)
+                quant_chunk = torch_npu.npu_quantize(
+                    chunk, scales_tensor[i],
+                    zero_points=None, dtype=recipes[i].quant_dtype, axis=-1
+                )
+                quant_chunks.append(quant_chunk)
+
+            quant_tensor = torch.stack(quant_chunks, dim=scatter_dim).view(*shape)
+            return quant_tensor, scales_tensor
+        else:
+            quant_chunks = []
+            scale_chunks = []
+            start_idx = 0
+
+            for i in range(self.world_size):
+                current_chunk_size = chunk_size + (1 if i < remainder else 0)
+                chunk = tensor.narrow(scatter_dim, start_idx, current_chunk_size)
+
+                quant_chunk = recipes[i].quantization(chunk, global_amax_vec[i].item())
+                quant_chunks.append(quant_chunk.data if isinstance(quant_chunk, Float8Tensor) else quant_chunk)
+                scale_chunks.append(quant_chunk.fp8_scale if isinstance(quant_chunk, Float8Tensor) else torch.ones(1, device=tensor.device)) 
+
+                start_idx += current_chunk_size
+
+            quant_tensor = torch.cat(quant_chunks, dim=scatter_dim)
+            scales = torch.stack(scale_chunks)
+
+            return quant_tensor, scales
+
+    def forward_all2all(
+        self,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        scatter_dim: int = 2,
+        gather_dim: int = 0,
+        gather_size: Optional[int] = None
+    ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+        if not self.enable_fp8_all2all or self.world_size == 1:
+            q_out, k_out, v_out = self._standard_all2all(query, key, value, scatter_dim, gather_dim, gather_size)
+            return q_out, k_out, v_out, None, None, None
+
+        # shape [b, n, s, d]
+        #       [0, 1, 2, 3]
+        chunk_dim = 1
+        q_amax_vec = self._compute_amax_per_chunk(query, chunk_dim)
+        k_amax_vec = self._compute_amax_per_chunk(key, chunk_dim)
+        v_amax_vec = self._compute_amax_per_chunk(value, chunk_dim)
+
+        combined_amax = torch.stack([q_amax_vec, k_amax_vec, v_amax_vec], dim=0)
+        global_combined_amax = self._allreduce_amax(combined_amax.flatten()).view(3, self.world_size)
+        global_q_amax = global_combined_amax[0]
+        global_k_amax = global_combined_amax[1]
+        global_v_amax = global_combined_amax[2]
+
+        quant_q, q_scales = self._quantize_chunks_with_global_amax(query, global_q_amax, self.q_recipes, chunk_dim)
+        quant_k, k_scales = self._quantize_chunks_with_global_amax(key, global_k_amax, self.k_recipes, chunk_dim)
+        quant_v, v_scales = self._quantize_chunks_with_global_amax(value, global_v_amax, self.v_recipes, chunk_dim)
+
+        output_q = self._fp8_all2all(quant_q, scatter_dim, gather_dim, gather_size)
+        output_k = self._fp8_all2all(quant_k, scatter_dim, gather_dim, gather_size)
+        output_v = self._fp8_all2all(quant_v, scatter_dim, gather_dim, gather_size)
+
+        q_scale = q_scales[0] if q_scales.numel() > 0 else torch.ones(1, device=query.device)
+        k_scale = k_scales[0] if k_scales.numel() > 0 else torch.ones(1, device=key.device)
+        v_scale = v_scales[0] if v_scales.numel() > 0 else torch.ones(1, device=value.device)
+
+        return output_q, output_k, output_v, q_scale, k_scale, v_scale
+
+    def _standard_all2all(
+        self,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        scatter_dim: int,
+        gather_dim: int,
+        gather_size: Optional[int]
+    ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        from mindspeed.core.context_parallel.ulysses_context_parallel.unaligned_cp.mapping import all_to_all
+
+        query_out = all_to_all(query, self.group, scatter_dim, gather_dim, gather_size)
+        key_out = all_to_all(key, self.group, scatter_dim, gather_dim, gather_size)
+        value_out = all_to_all(value, self.group, scatter_dim, gather_dim, gather_size)
+
+        return query_out, key_out, value_out
+
+    def _fp8_all2all(
+        self,
+        tensor: torch.Tensor,
+        scatter_dim: int,
+        gather_dim: int,
+        gather_size: Optional[int] = None
+    ) -> torch.Tensor:
+        from mindspeed.core.context_parallel.ulysses_context_parallel.unaligned_cp.mapping import _all_to_all
+
+        return _all_to_all(tensor, self.group, scatter_dim, gather_dim, gather_size)
+
+
