+import math
+
+import torch
+import torch.nn.functional as F
+import torch_npu
+
+from megatron.training import get_args
+from mindspeed_mm.utils.async_offload import async_save_on_cpu
+import numpy as np
+
+
+PER_BLOCK_Q_SIZE = 128
+PER_BLOCK_KV_SIZE = 256
+FP8_MAX = 448.0
+
+
+def calc_scale_size(tensor, block_size):
+    if tensor.dim() != 4:
+        raise ValueError(f"Input must be 4D tensor [B, N, S, D], got shape {tensor.shape}")
+    if block_size <= 0:
+        raise ValueError(f"block_size must be positive, got {block_size}")
+
+    B, N, S, D = tensor.shape
+    pad_len = (block_size - S % block_size) % block_size
+    S_padded = S + pad_len if pad_len > 0 else S
+
+    return torch.Size([B, N, S_padded // block_size, block_size * D])
+
+class CustomQuantFlashAttentionFunc(torch.autograd.Function):
+    @staticmethod
+    def forward(
+        ctx,
+        query, key, value,
+        head_num,
+        layout,
+        pse,
+        padding_mask,
+        atten_mask,
+        actual_seq_qlen,
+        actual_seq_kvlen,
+        scale,
+        keep_prob,
+        inner_precise,
+        sparse_mode,
+        qkv_scaler
+    ):
+
+        query_scale_size_128 = calc_scale_size(query, block_size=128)
+        key_scale_size_256 = calc_scale_size(key, block_size=256)
+        value_scale_size_512 = calc_scale_size(value, block_size=512)
+
+        q_scaler_128, k_scaler_256, v_scaler_512, dy_scaler = qkv_scaler
+
+        query_fp8_128 = q_scaler_128.quantization(query, None, None, None)
+        key_fp8_256 = k_scaler_256.quantization(key, None, None, None)
+        value_fp8_512 = v_scaler_512.quantization(value, None, None, None)
+
+        query_scale_128 = query_fp8_128.fp8_scale.broadcast_to((*query_scale_size_128[:-1], 1))
+        key_scale_256 = key_fp8_256.fp8_scale.broadcast_to((*key_scale_size_256[:-1], 1))
+        value_scale_512 = value_fp8_512.fp8_scale.broadcast_to((*value_scale_size_512[:-1], 1))
+
+        query_scale_size_512 = calc_scale_size(query, block_size=512)
+        key_scale_size_512 = calc_scale_size(key, block_size=512)
+        value_scale_size_512 = calc_scale_size(value, block_size=512)
+
+        query_scale_512_bw = query_fp8_128.fp8_scale.broadcast_to((*query_scale_size_512[:-1], 1))
+        key_scale_512_bw = key_fp8_256.fp8_scale.broadcast_to((*key_scale_size_512[:-1], 1))
+        value_scale_512_bw = value_fp8_512.fp8_scale.broadcast_to((*value_scale_size_512[:-1], 1))
+
+        q_fw = query_fp8_128.data.permute(0, 2, 1, 3).contiguous()
+        k_fw = key_fp8_256.data.permute(0, 2, 1, 3).contiguous()
+        v_fw = value_fp8_512.data.permute(0, 2, 1, 3).contiguous()
+
+        p_scale_tensor_cpu = torch.ones(1,  dtype=torch.float, device=torch.device('cpu')) * 15
+        p_scale_tensor = p_scale_tensor_cpu.npu()
+
+        layout_fw = 'BSND'
+        res = torch_npu.npu_quant_fusion_attention(
+            q_fw, k_fw, v_fw, head_num, layout_fw,
+            scale=scale,
+            d_scale_q=query_scale_128,
+            d_scale_k=key_scale_256,
+            d_scale_v=value_scale_512,
+            query_dtype=torch_npu.hifloat8,
+            p_scale=p_scale_tensor
+        )
+
+        attn = res[0]
+        softmax_max = res[1]
+        softmax_sum = res[2]
+
+        ctx.save_for_backward(
+            q_fw, k_fw, v_fw,
+            attn, softmax_max, softmax_sum,
+            query_scale_512_bw, key_scale_512_bw, value_scale_512_bw
+        )
+
+        ctx.head_num = head_num
+        ctx.layout = layout
+        ctx.pse = pse
+        ctx.padding_mask = padding_mask
+        ctx.atten_mask = atten_mask
+        ctx.actual_seq_qlen = actual_seq_qlen
+        ctx.actual_seq_kvlen = actual_seq_kvlen
+        ctx.scale_value = scale
+        ctx.keep_prob = keep_prob
+        ctx.inner_precise = inner_precise
+        ctx.sparse_mode = sparse_mode
+        ctx.out_dtype = 1
+        ctx.query_dtype = torch_npu.hifloat8
+        ctx.dy_scaler = dy_scaler
+
+        attn_return = attn.permute(0, 2, 1, 3).contiguous()
+
+        return attn_return
+
+    @staticmethod
+    def backward(ctx, dy):
+        q, k, v, attn_in, softmax_max, softmax_sum, d_scale_q, d_scale_k, d_scale_v = ctx.saved_tensors
+
+        dy_scale_size = calc_scale_size(dy, block_size=512)
+
+        dy_fp8_512 = ctx.dy_scaler.quantization(dy, None, None, None)
+        dy_scale_512 = dy_fp8_512.fp8_scale.broadcast_to((*dy_scale_size[:-1], 1))
+
+        head_num_bw = q.shape[2]
+        dy_bw = dy_fp8_512.data.permute(0, 2, 1, 3).contiguous()
+
+        layout_bw = 'BSND'
+
+        p_scale_tensor_cpu = torch.ones(1,  dtype=torch.float, device=torch.device('cpu')) * 15
+        p_scale_tensor = p_scale_tensor_cpu.npu()
+
+        ds_scale_tensor_cpu = torch.ones(1,  dtype=torch.float, device=torch.device('cpu')) * (2 ** 15)
+        ds_scale_tensor = ds_scale_tensor_cpu.npu()
+
+        res = torch_npu.npu_quant_fusion_attention_grad(
+            q,
+            k,
+            v,
+            dy_bw,
+            head_num=head_num_bw,
+            input_layout=layout_bw,
+            softmax_max=softmax_max,
+            softmax_sum=softmax_sum,
+            attention_in=attn_in,
+            scale_value=ctx.scale_value,
+            d_scale_q=d_scale_q,
+            d_scale_k=d_scale_k,
+            d_scale_v=d_scale_v,
+            d_scale_dy=dy_scale_512,
+            query_dtype=ctx.query_dtype,
+            p_scale=p_scale_tensor,
+            ds_scale=ds_scale_tensor
+        )
+
+        dq = res[0].permute(0, 2, 1, 3).contiguous()
+        dk = res[1].permute(0, 2, 1, 3).contiguous()
+        dv = res[2].permute(0, 2, 1, 3).contiguous()
+
+        return dq, dk, dv, None, None, None, None, None, None, None, None, None, None, None, None
