+class FP8UlyssesContextAttention(torch.nn.Module):
+    def __init__(
+        self,
+        local_attention: torch.nn.Module,
+        sequence_process_group: torch.distributed.ProcessGroup,
+        scatter_dim: int = 2,
+        gather_dim: int = 0,
+        enable_fp8_all2all: bool = False,
+    ):
+        super().__init__()
+        self.local_attn = local_attention
+        self.enable_fp8_all2all = enable_fp8_all2all
+
+        self.fp8_comm = FP8All2AllCommunication(
+            group=sequence_process_group,
+            enable_fp8_all2all=enable_fp8_all2all
+        )
+
+        self.local_attn.ulysses_comm_para = {
+            'spg': sequence_process_group,
+            'scatter_dim': scatter_dim,
+            'gather_dim': gather_dim,
+            'enable_fp8_all2all': enable_fp8_all2all,
+        }
+
+        if enable_fp8_all2all:
+            self.fp8_flash_attn = FP8All2AllFlashAttention(
+                softmax_scale=local_attention.softmax_scale if hasattr(local_attention, 'softmax_scale') else None,
+                attention_dropout=local_attention.attention_dropout if hasattr(local_attention, 'attention_dropout') else 0.0,
+                fa_layout=local_attention.fa_layout if hasattr(local_attention, 'fa_layout') else "bnsd",
+                dy_scaler=self.fp8_comm.dy_recipe
+            )
+
+    def forward(self, query, key, value, *args, **kwargs):
+        from mindspeed.core.context_parallel import get_args
+        from mindspeed.core.context_parallel.ulysses_context_parallel.unaligned_cp.mapping import all_to_all, cal_split_sizes
+
+        global_args = get_args()
+        use_custom_ulysses_backward = (
+            global_args.context_parallel_size > 1 and
+            global_args.context_parallel_algo == "ulysses_cp_algo" and
+            not global_args.use_legacy_models and
+            global_args.context_parallel_kv_cache_policy
+        )
+
+        if use_custom_ulysses_backward:
+            output = self.local_attn(query, key, value, *args, **kwargs)
+        else:
+            spg = self.local_attn.ulysses_comm_para.get('spg')
+            scatter_dim = self.local_attn.ulysses_comm_para.get('scatter_dim')
+            gather_dim = self.local_attn.ulysses_comm_para.get('gather_dim')
+            enable_fp8 = self.local_attn.ulysses_comm_para.get('enable_fp8_all2all', False)
+            seq_world_size = torch.distributed.get_world_size(spg)
+
+            if seq_world_size > key.shape[scatter_dim] and query.shape[scatter_dim] % key.shape[scatter_dim] == 0:
+                key = key.repeat_interleave(query.shape[scatter_dim] // key.shape[scatter_dim], dim=scatter_dim)
+                value = value.repeat_interleave(query.shape[scatter_dim] // value.shape[scatter_dim], dim=scatter_dim)
+
+            gather_size_calculator = self.local_attn.ulysses_comm_para.get('gather_size_calculator')
+            gather_size = gather_size_calculator.calculate(*args, **kwargs) if gather_size_calculator else None
+
+            if enable_fp8 and self.fp8_comm.enable_fp8_all2all:
+                query_layer, key_layer, value_layer, q_scale, k_scale, v_scale = self.fp8_comm.forward_all2all(
+                    query, key, value, scatter_dim, gather_dim, gather_size
+                )
+
+                context_layer = self.fp8_flash_attn(
+                    query_layer, key_layer, value_layer,
+                    q_scale, k_scale, v_scale,
+                    layout="BNSD",
+                    attn_mask=kwargs.get('mask', None),
+                    dropout_p=self.fp8_flash_attn.attention_dropout,
+                    sparse_mode=global_args.sparse_mode if hasattr(global_args, 'sparse_mode') else 0,
+                )
+            else:
+                query_layer = all_to_all(query, spg, scatter_dim, gather_dim, gather_size)
+                key_layer = all_to_all(key, spg, scatter_dim, gather_dim, gather_size)
+                value_layer = all_to_all(value, spg, scatter_dim, gather_dim, gather_size)
+                context_layer = self.local_attn(query_layer, key_layer, value_layer, *args, **kwargs)
+            gather_size = None
+            gather_dim = 0
+            scatter_dim = 2
+            if gather_size:
+                context_shape = context_layer.shape
+                scatter_sizes_query = cal_split_sizes(query.shape[scatter_dim], seq_world_size)
+                context_layer = context_layer.reshape(
+                    context_shape[0], context_shape[1],
+                    scatter_sizes_query[torch.distributed.get_rank(spg)], -1
+                ).contiguous()
+
+            output = all_to_all(context_layer, spg, gather_dim, scatter_dim, query.size(scatter_dim))
+
+            if gather_size:
+                output = output.reshape(output.shape[0], output.shape[1], -1).contiguous()
+
+            return output
