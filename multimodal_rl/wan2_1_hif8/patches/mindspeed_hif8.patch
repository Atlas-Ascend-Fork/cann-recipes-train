@@ -0,0 +1,145 @@
+import dataclasses
+import typing
+from typing import Optional, Tuple
+
+import torch
+
+from mindspeed.te.pytorch.fp8.recipes.forward_delayed_scaling_recipe import ForwardDelayedScaling
+from mindspeed.te.pytorch.fp8.recipes.backward_delayed_scaling_recipe import BackwardDelayedScaling
+from mindspeed.te.pytorch.fp8.recipes.recipe import RecipeScaling
+from mindspeed.te.pytorch.fp8.recipes.recipe import MyRecipeConfig
+
+
+@dataclasses.dataclass
+class DualDelayedScaling(RecipeScaling):
+    """
+    双重 Delayed Scaling 配置类
+    同时管理 Forward 和 Backward 阶段的不同配置
+    """
+
+    def __init__(
+        self,
+        # 通用参数
+        amax_reduce_group: Optional[torch.distributed.ProcessGroup] = None,
+        override_linear_precision: Optional[Tuple] = None,
+
+        # Forward 阶段专用参数
+        fp8_forward_margin: float = 0.0,
+        fp8_forward_amax_history_len: int = 1024,
+        fp8_forward_amax_compute_algo: str = "max",
+        fp8_forward_interval: int = 1,
+
+        # Backward 阶段专用参数
+        fp8_backward_margin: float = 0.0,
+        fp8_backward_amax_history_len: int = 1024,
+        fp8_backward_amax_compute_algo: str = "max",
+        fp8_backward_interval: int = 1,
+
+        # 其他配置
+        fp8_format: str = "E4M3",
+        fp8_block_size: int = 128,
+        config=None
+    ):
+        """
+        初始化双重 delayed scaling 配置
+
+        Args:
+            amax_reduce_group: amax 归约的进程组
+            override_linear_precision: 覆盖线性精度的配置
+
+            fp8_forward_*: Forward 阶段的专用参数
+            fp8_backward_*: Backward 阶段的专用参数
+
+            fp8_format: FP8 格式 (e4m3/hybrid/hif8)
+            fp8_block_size: 块大小 (用于块状量化)
+        """
+        self.amax_reduce_group = amax_reduce_group
+        self.override_linear_precision = override_linear_precision
+        forward_recipe_config = MyRecipeConfig(
+            fp8_margin=fp8_forward_margin,
+            fp8_amax_compute_algo=fp8_forward_amax_compute_algo,
+            fp8_amax_history_len=fp8_forward_amax_history_len,
+            fp8_interval=fp8_forward_interval
+        )
+
+        backward_recipe_config = MyRecipeConfig(
+            fp8_margin=fp8_backward_margin,
+            fp8_amax_compute_algo=fp8_backward_amax_compute_algo,
+            fp8_amax_history_len=fp8_backward_amax_history_len,
+            fp8_interval=fp8_backward_interval
+        )
+
+        # 创建 Forward 专用配置
+        self.forward_config = ForwardDelayedScaling(
+            fp8_format=fp8_format,
+            config=forward_recipe_config,
+            override_linear_precision=(False, False, not config.fp8_wgrad),
+            amax_reduce_group=amax_reduce_group
+        )
+
+        # 创建 Backward 专用配置
+        self.backward_config = BackwardDelayedScaling(
+            fp8_format=fp8_format,
+            config=backward_recipe_config,
+            override_linear_precision=(False, False, not config.fp8_wgrad),
+            amax_reduce_group=amax_reduce_group
+        )
+
+        # 通用配置
+        self.fp8_format = fp8_format
+        self.fp8_block_size = fp8_block_size
+
+    def get_forward_config(self):
+        """获取 Forward 阶段的配置"""
+        return self.forward_config
+
+    def get_backward_config(self):
+        """获取 Backward 阶段的配置"""
+        return self.backward_config
+
+    def is_dual_recipe(self):
+        """判断是否为双重 recipe 配置"""
+        return True
+
+
+# 工厂函数用于创建双重配置
+def create_dual_delayed_scaling(
+    forward_margin: float = 0.0,
+    forward_history_len: int = 1024,
+    forward_compute_algo: str = "max",
+    forward_interval: int = 1,
+
+    backward_margin: float = 0.0,
+    backward_history_len: int = 1024,
+    backward_compute_algo: str = "max",
+    backward_interval: int = 1,
+
+    amax_reduce_group: Optional[torch.distributed.ProcessGroup] = None,
+    fp8_format: str = "E4M3",
+    config=None
+) -> DualDelayedScaling:
+    """
+    创建具有不同前后向配置的双重 delayed scaling
+
+    Args:
+        forward_*: Forward 阶段参数
+        backward_*: Backward 阶段参数
+        amax_reduce_group: 进程组
+        fp8_format: FP8 格式
+
+    Returns:
+        DualDelayedScaling 配置对象
+    """
+    return DualDelayedScaling(
+        amax_reduce_group=amax_reduce_group,
+        fp8_forward_margin=forward_margin,
+        fp8_forward_amax_history_len=forward_history_len,
+        fp8_forward_amax_compute_algo=forward_compute_algo,
+        fp8_forward_interval=forward_interval,
+        fp8_backward_margin=backward_margin,
+        fp8_backward_amax_history_len=backward_history_len,
+        fp8_backward_amax_compute_algo=backward_compute_algo,
+        fp8_backward_interval=backward_interval,
+        fp8_format=fp8_format,
+        config=config
+    )
