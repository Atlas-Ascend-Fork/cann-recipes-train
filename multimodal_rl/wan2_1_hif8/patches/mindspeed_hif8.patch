 from mindspeed.te.pytorch.fp8.tensor import Float8Tensor, is_fp8_tensor
 
+class DelayedScalingRecipeFA(Recipe):
+    ALL_SCALING = []
+    MAX_STREAM = None
+
+    def __init__(self, key, recipe_config: 'TEDelayedScaling', tensor_shape) -> None:
+        super().__init__(key, recipe_config, tensor_shape)
+        if DelayedScalingRecipeFA.MAX_STREAM is None:
+            DelayedScalingRecipeFA.MAX_STREAM = torch.cuda.Stream()
+        self.scale = None
+        self.recipe_config = recipe_config
+
+        DelayedScalingRecipeFA.ALL_SCALING.append(self)
+        # MAX_STREAM need to wait ScaleData finished the initialization
+        DelayedScalingRecipeFA.MAX_STREAM.wait_stream(torch.cuda.current_stream())
+
+    def finally_step(self):
+        torch.cuda.current_stream().wait_stream(DelayedScalingRecipeFA.MAX_STREAM)
+        if self.scale is not None:
+            self.scale.delayed_recipe_update_scale()
+
+    def quantization(self, tensor, key, colwise, rowwise):
+        if tensor is None:
+            return tensor
+        if is_fp8_tensor(tensor):  # if dtype is fp8 return
+            return tensor
+        if self.scale == None:
+            self.scale = ScaleDataFA(self.recipe_config, self.fp8_format)
+        scale = self.scale.delayed_recipe_update_amax(tensor, DelayedScalingRecipeFA.MAX_STREAM)
+        quant_tensor = torch_npu.npu_quantize(tensor, scale, zero_points=None, dtype=self.quant_dtype, axis=-1)
+        return Float8Tensor(quant_tensor, self.quant_dtype, scale, dtype=tensor.dtype)
+
+    def pertoken_quantization(self, tensor, key, colwise, rowwise):
+        if tensor is None:
+            return tensor
+        if is_fp8_tensor(tensor):  # if dtype is fp8 return
+            return tensor
+        self.shape = tensor.shape
+        tensor = tensor.view(-1, tensor.shape[-1])
+        if self.scale == None:
+            self.scale = ScaleDataFA(self.recipe_config, self.fp8_format, [tensor.shape[-2]])
+        scale = self.scale.delayed_recipe_update_amax(tensor, DelayedScalingRecipeFA.MAX_STREAM, amax_dim=1)
+        quant_tensor = torch_npu.npu_quantize(tensor, scale, zero_points=None, dtype=self.quant_dtype, axis=-2)
+        quant_tensor = quant_tensor.view(self.shape)
+        scale = scale.view(*self.shape[:-1], 1)
+        return Float8Tensor(quant_tensor, self.quant_dtype, scale, dtype=tensor.dtype)
 
 class DelayedScalingRecipe(Recipe):
     ALL_SCALING = []
