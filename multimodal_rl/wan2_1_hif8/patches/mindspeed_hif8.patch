new file mode 100644
index 00000000..e6c02bc3
--- /dev/null
+++ b/mindspeed/te/pytorch/fp8/dual_metadata.py
@@ -0,0 +1,193 @@
+# 目标文件: MindSpeed/mindspeed/te/pytorch/fp8/dual_metadata.py
+# 改动性质: U 新增文件(标签页 "1, U",非 diff 视图,全文即新增)
+import torch
+from typing import Optional
+
+from mindspeed.te.pytorch.fp8.metadata import FP8Metadata
+from mindspeed.te.pytorch.fp8.constants import TensorKey
+from mindspeed.te.pytorch.module_typing import FP8Recipe, FP8Tensor 
+
+
+class FP8DualMetadata(FP8Metadata):
+    """
+    支持前后向分离 recipe 管理的 FP8 元数据类
+    继承自 FP8Metadata, 扩展了对 Forward 和 Backward 阶段分别管理的能力
+    """
+
+    def __init__(self, keys=None):
+        """
+        初始化双 recipe 管理的元数据
+
+        Args:
+            keys: 需要管理的张量键列表, 默认为 [inputs, weight, grads]
+        """
+        super().__init__(keys)
+        # 分别存储 forward 和 backward 阶段的 recipes
+        self.forward_recipes = {}
+        self.backward_recipes = {}
+        # 标记当前处于哪个阶段
+        self.is_forward_phase = True
+
+    def set_forward_phase(self):
+        """设置为 forward 阶段"""
+        self.is_forward_phase = True
+
+    def set_backward_phase(self):
+        """设置为 backward 阶段"""
+        self.is_forward_phase = False
+
+    def is_in_forward_phase(self) -> bool:
+        """判断是否处于 forward 阶段"""
+        return self.is_forward_phase
+
+    def create_recipe(self, key: TensorKey, config, tensor_shape) -> 'FP8Recipe':
+        """
+        根据当前阶段创建对应的 recipe
+
+        Args:
+            key: 张量键
+            config: 配置对象
+            tensor_shape: 张量形状
+
+        Returns:
+            对应阶段的 recipe 实例
+        """
+        # 检查是否为双重配置
+        if hasattr(config, 'is_dual_recipe') and config.is_dual_recipe():
+            if self.is_forward_phase:
+                # 使用 forward 专用配置
+                forward_config = config.get_forward_config()
+                return forward_config.recipe(key, forward_config, tensor_shape)
+            else:
+                # 使用 backward 专用配置
+                backward_config = config.get_backward_config()
+                return backward_config.recipe(key, backward_config, tensor_shape)
+        else:
+            # 非双重配置, 回退到原有逻辑
+            return super().create_recipe(key, config, tensor_shape)
+
+    def init_recipes_if_necessarily(self, key, tensor_shape=None):
+        """
+        根据当前阶段初始化对应的 recipes
+
+        Args:
+            key: 张量键
+            tensor_shape: 张量形状
+        """
+        recipe_dict = self.forward_recipes if self.is_forward_phase else self.backward_recipes
+
+        if key in recipe_dict:
+            return
+
+        recipe = self.create_recipe(key, self.fp8_recipe, tensor_shape)
+        recipe_dict[key] = recipe
+
+    def get_current_recipe(self, key: TensorKey):
+        """
+        获取当前阶段对应键的 recipe
+
+        Args:
+            key: 张量键
+
+        Returns:
+            当前阶段的 recipe 实例
+        """
+        recipe_dict = self.forward_recipes if self.is_forward_phase else self.backward_recipes
+        return recipe_dict.get(key)
+
+    def quantization(self, key: TensorKey, tensor: torch.Tensor, colwise=True, rowwise=True) -> 'FP8Tensor':
+        """
+        根据当前阶段进行量化
+
+        Args:
+            key: 张量键
+            tensor: 待量化的张量
+            colwise: 列方向量化标志
+            rowwise: 行方向量化标志
+
+        Returns:
+            量化后的 FP8Tensor
+        """
+        self.init_recipes_if_necessarily(key, tensor.shape)
+        recipe = self.get_current_recipe(key)
+        if recipe is None:
+            # 如果当前阶段没有对应的 recipe, 尝试初始化
+            recipe = self.create_recipe(key, self.fp8_recipe, tensor.shape)
+            if self.is_forward_phase:
+                self.forward_recipes[key] = recipe
+            else:
+                self.backward_recipes[key] = recipe
+
+        return recipe.quantization(tensor, key, colwise=colwise, rowwise=rowwise)
+
+    def cleanup_forward_recipes(self):
+        """清理 forward 阶段的 recipes, 释放内存"""
+        self.forward_recipes.clear()
+
+    def cleanup_backward_recipes(self):
+        """清理 backward 阶段的 recipes, 释放内存"""
+        self.backward_recipes.clear()
+
+    def cleanup_all_recipes(self):
+        """清理所有阶段的 recipes"""
+        self.cleanup_forward_recipes()
+        self.cleanup_backward_recipes()
+
+
+# 上下文管理器用于自动切换阶段
+class DualPhaseContext:
+    """
+    双阶段上下文管理器
+    自动处理 forward/backward 阶段的切换
+    """
+
+    def __init__(self, fp8_meta: FP8DualMetadata, phase: str):
+        """
+        初始化上下文管理器
+
+        Args:
+            fp8_meta: FP8DualMetadata 实例
+            phase: 阶段名称 ('forward' 或 'backward')
+        """
+        self.fp8_meta = fp8_meta
+        self.phase = phase
+        self.previous_phase = None
+
+    def __enter__(self):
+        """进入上下文, 切换到指定阶段"""
+        self.previous_phase = self.fp8_meta.is_forward_phase
+        if self.phase == 'forward':
+            self.fp8_meta.set_forward_phase()
+        else:
+            self.fp8_meta.set_backward_phase()
+        return self.fp8_meta
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        """退出上下文, 恢复之前的阶段"""
+        if self.previous_phase is not None:
+            self.fp8_meta.is_forward_phase = self.previous_phase
+
+
+# 便捷函数
+def forward_phase_context(fp8_meta: FP8DualMetadata):
+    """创建 forward 阶段上下文"""
+    return DualPhaseContext(fp8_meta, 'forward')
+
+
+def backward_phase_context(fp8_meta: FP8DualMetadata):
+    """创建 backward 阶段上下文"""
+    return DualPhaseContext(fp8_meta, 'backward')
+
+
+# 工厂函数创建双重元数据实例
+def create_dual_metadata(keys=None) -> FP8DualMetadata:
+    """
+    创建支持双 recipe 管理的 FP8 元数据实例
+
+    Args:
+        keys: 需要管理的张量键列表
+
+    Returns:
+        FP8DualMetadata 实例
+    """
+    return FP8DualMetadata(keys)
