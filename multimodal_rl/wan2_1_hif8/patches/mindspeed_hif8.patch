+import torch
+import torch.nn as nn
+from mindspeed.te.pytorch.module.linear import TEColumnParallelLinear
+from mindspeed.te.pytorch.module.dual_recipe_column_linear import DualRecipeColumnParallelLinear
+from megatron.core.model_parallel_config import ModelParallelConfig
+from megatron.core.utils import init_method_normal
+
+
+class TEFFN(nn.Module):
+    """
+    兼容旧权重格式的FFN模块。
+    将层名称修改为 '0', '1', '2' 以匹配 nn.Sequential 的权重命名。
+    """
+
+    def __init__(self, hidden_size, ffn_dim, config=None):
+        super().__init__()
+        self.hidden_size = hidden_size
+        self.ffn_dim = ffn_dim
+
+        #ColumnParallelLinear = TEColumnParallelLinear
+        ColumnParallelLinear = DualRecipeColumnParallelLinear
+
+        # === 关键修改开始 ===
+        # 创建层对象,但不直接赋值给 self.linear1,而是先用变量保存
+        _linear1 = ColumnParallelLinear(
+            input_size=hidden_size,
+            output_size=ffn_dim,
+            config=config,
+            init_method=config.init_method,
+            gather_output=False,
+            bias=True,
+            skip_bias_add=False,
+            is_expert=False,
+            skip_weight_param_allocation=False
+        )
+
+        _activation = nn.GELU(approximate="tanh")
+
+        _linear2 = ColumnParallelLinear(
+            input_size=ffn_dim,
+            output_size=hidden_size,
+            config=config,
+            init_method=config.init_method,
+            gather_output=False,
+            bias=True,
+            skip_bias_add=False,
+            is_expert=False,
+            skip_weight_param_allocation=False
+        )
+
+        # 使用 add_module 将层注册为 '0', '1', '2'
+        # 这样在 state_dict 中就会出现 ffn.0.weight, ffn.2.weight 等
+        # 从而能够直接加载旧权重的 blocks.x.ffn.0.weight
+        self.add_module('0', _linear1)
+        self.add_module('1', _activation)
+        self.add_module('2', _linear2)
+
+    def forward(self, x):
+        # 前向传播时, 通过 _modules 字典或 getattr 获取层
+        # 因为 Python 不支持 self.0 这种写法
+
+        # 第一层线性变换 (对应 self._modules['0'])
+        hidden, _ = self._modules['0'](x)
+
+        # GELU激活 (对应 self._modules['1'])
+        hidden = self._modules['1'](hidden)
+
+        # 第二层线性变换 (对应 self._modules['2'])
+        output, _ = self._modules['2'](hidden)
+
+        return output
