@@ -0,0 +1,77 @@
+import dataclasses
+import typing
+from typing import Optional
+
+import torch
+
+import torch_npu
+from mindspeed.te.pytorch.fp8.recipes.recipe import Recipe, RecipeScaling
+from mindspeed.te.pytorch.fp8.scale_data import ScaleData
+from mindspeed.te.pytorch.fp8.tensor import Float8Tensor, is_fp8_tensor
+from mindspeed.te.pytorch.fp8.recipes.recipe import MyRecipeConfig
+
+
+class BackwardDelayedScalingRecipe(Recipe):
+    """
+    Backward 阶段专用的 Delayed Scaling Recipe
+    用于 backward pass 中的 FP8 量化, 具有独立的配置和状态管理
+    """
+    ALL_BACKWARD_SCALING = []
+    BACKWARD_MAX_STREAM = None
+
+    def __init__(self, key, recipe_config: 'BackwardDelayedScaling', tensor_shape) -> None:
+        """
+        初始化 Backward 阶段的 delayed scaling recipe
+
+        Args:
+            key: 张量键值 (inputs/weight/grads)
+            recipe_config: Backward 专用的配置对象
+            tensor_shape: 输入张量形状
+        """
+        super().__init__(key, recipe_config, tensor_shape)
+        if BackwardDelayedScalingRecipe.BACKWARD_MAX_STREAM is None:
+            BackwardDelayedScalingRecipe.BACKWARD_MAX_STREAM = torch.cuda.Stream()
+        self.scale = ScaleData(recipe_config, self.fp8_format)
+
+        BackwardDelayedScalingRecipe.ALL_BACKWARD_SCALING.append(self)
+        # 等待 ScaleData 完成初始化
+        BackwardDelayedScalingRecipe.BACKWARD_MAX_STREAM.wait_stream(torch.cuda.current_stream())
+
+    def finally_step(self):
+        """Backward 阶段结束时的清理操作"""
+        torch.cuda.current_stream().wait_stream(BackwardDelayedScalingRecipe.BACKWARD_MAX_STREAM)
+        self.scale.delayed_recipe_update_scale()
+
+    def quantization(self, tensor, key, colwise=True, rowwise=True):
+        """
+        Backward 阶段的量化方法
+
+        Args:
+            tensor: 待量化的张量
+            key: 张量类型标识
+            colwise: 列方向量化标志
+            rowwise: 行方向量化标志
+
+        Returns:
+            量化后的 Float8Tensor
+        """
+        if tensor is None:
+            return tensor
+        if is_fp8_tensor(tensor):  # 如果已经是 fp8 格式则直接返回
+            return tensor
+        # 使用 backward 专用的流进行 amax 更新
+        scale = self.scale.delayed_recipe_update_amax(tensor, BackwardDelayedScalingRecipe.BACKWARD_MAX_STREAM)  
+        quant_tensor = torch_npu.npu_quantize(tensor, scale, zero_points=None, dtype=self.quant_dtype, axis=-1)
+        return Float8Tensor(quant_tensor, self.quant_dtype, scale, dtype=tensor.dtype)
+
+
+@dataclasses.dataclass
+class BackwardDelayedScaling(RecipeScaling):
+    """
+    Backward 阶段 Delayed Scaling 的配置类
+    可以设置与 forward 不同的参数
+    """
+    recipe = BackwardDelayedScalingRecipe
+    amax_reduce_group: torch.distributed.ProcessGroup = None
+    override_linear_precision: Optional[typing.Tuple] = None
+    config: MyRecipeConfig = None  
