+                    if ACTIVATION == "swish" or ACTIVATION == "silu":  # pylint: disable=consider-using-in
+                        b_y = tl.load(
+                            y + bos * D + o_t_iw[:, None] * D + o_d[None, :],
+                            mask=m_t_iw[:, None] & m_d[None, :],
+                            other=0.0,
