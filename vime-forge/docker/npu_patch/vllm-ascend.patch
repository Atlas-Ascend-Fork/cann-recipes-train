new file mode 100644
index 000000000..4fbdc7848
--- /dev/null
+++ b/tests/e2e/pull_request/two_card/test_pyhccl_broadcast.py
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All Rights Reserved.
+
+import pytest
+import torch
+import torch_npu  # noqa: F401
+from vllm.utils.network_utils import get_open_port
+
+
+def _broadcast_byte_storage(rank: int, port: int, dtype_name: str):
+    # Match weight transfer: trainer rank 0 uses device 1, worker rank 1 device 0.
+    device = 1 - rank
+    torch.npu.set_device(device)
+    from vllm_ascend.distributed.weight_transfer.hccl_engine import HCCLWeightTransferEngine
+
+    communicator = HCCLWeightTransferEngine._stateless_init_process_group("127.0.0.1", port, rank, 2, device)
+    assert communicator.available and not communicator.disabled
+    dtype = getattr(torch, dtype_name)
+    for numel in (256, 2**20):
+        # Include all byte patterns, including FP8 NaNs, and compare storage
+        # rather than values to detect any changed payload bits.
+        expected = (torch.arange(numel, dtype=torch.int64) % 256).to(torch.uint8)
+        for src in (0, 1):
+            tensor = torch.empty(numel, dtype=torch.uint8, device=f"npu:{device}").view(dtype)
+            tensor.view(torch.uint8).copy_(expected if rank == src else torch.zeros_like(expected))
+            communicator.broadcast(tensor, src=src)
+            torch.npu.synchronize()
+            assert tensor.dtype == dtype
+            assert torch.equal(tensor.cpu().view(torch.uint8), expected), (rank, dtype_name, numel, src)
+    communicator.group.barrier()
+    communicator.hccl.hcclCommDestroy(communicator.comm)
+
+
+@pytest.mark.skipif(torch.npu.device_count() < 2, reason="HCCL broadcast requires at least 2 NPUs.")
+@pytest.mark.parametrize("dtype_name", ["uint8", "float8_e4m3fn", "float8_e5m2"])
+def test_hccl_broadcast_preserves_byte_storage(dtype_name):
+    """FP8 weight transfer preserves every payload byte through native HCCL."""
+    torch.multiprocessing.spawn(_broadcast_byte_storage, args=(get_open_port(), dtype_name), nprocs=2, join=True)
