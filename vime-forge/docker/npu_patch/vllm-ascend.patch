new file mode 100644
index 000000000..0fde47c89
--- /dev/null
+++ b/vllm_ascend/ops/lightning_indexer_mxfp4.py
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import torch
+
+MXFP4_BLOCK_SIZE = 32
+
+
+def is_dsv4_mxfp4_indexer(vllm_config) -> bool:
+    """Resolve the DSV4 LI format independently of the attention cache dtype."""
+    from vllm_ascend.device.hardware_profile import HardwareCapability, get_current_hardware_profile
+
+    enabled = vllm_config.attention_config.indexer_kv_dtype == "mxfp4"
+    if enabled and not get_current_hardware_profile().supports(HardwareCapability.DSV4_COMPRESSED_CACHE):
+        raise ValueError("DeepSeek V4 MXFP4 indexer cache requires A5")
+    return enabled
+
+
+def quantize_mxfp4(x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize BF16/FP16 indexer Q or K on device, using torchao_npu defaults.
+
+    Returns uint8 E2M1 packed bytes and E8M0 scales with paired trailing axes.
+    ``scale_alg=2`` and nearest-even rounding match torchao_npu MXQuantizeConfig.
+    Quantization acts on the final dimension; the indexer requires head_dim=128.
+    """
+    import torch_npu
+
+    original_shape = x.shape
+    packed, scale = torch_npu.npu_dynamic_mx_quant(
+        x,
+        dst_type=torch_npu.float4_e2m1fn_x2,
+        axis=-1,
+        block_size=MXFP4_BLOCK_SIZE,
+        round_mode="rint",
+        scale_alg=2,
+    )
+    # CANN returns one E8M0 scale per 32-value block, represented as
+    # ``[..., D/64, 2]`` for the packed FP4 stream.
+    scale = scale.view(*original_shape[:-1], original_shape[-1] // (MXFP4_BLOCK_SIZE * 2), 2)
+    return packed.view(torch.uint8), scale.view(torch.float8_e8m0fnu)
+
+
+def scatter_mxfp4_cache(key, scale, key_cache, scale_cache, slot_mapping):
+    """Write packed K and E8M0 bytes into the shared paged cache."""
+    import torch_npu
+
+    num_rows = key.numel() // key.shape[-1]
+    if num_rows == 0:
+        return
+    slots = slot_mapping.reshape(-1)
+    block_size = key_cache.shape[1]
+    # Keep page/offset indices: flattening these non-contiguous views would copy.
+    # A5 CANN skips the negative page index corresponding to a padding slot (-1).
+    indices = torch.stack((slots // block_size, slots % block_size, torch.zeros_like(slots)), dim=1)
+
+    torch_npu.npu_scatter_nd_update_(
+        key_cache.view(torch.uint8), indices, key.view(torch.uint8).reshape(num_rows, -1)
+    )
+    torch_npu.npu_scatter_nd_update_(
+        scale_cache.view(torch.uint8), indices, scale.view(torch.uint8).reshape(num_rows, -1)
+    )
