+    def _weight_update_groups(self, update_info) -> list[list[tuple[str, list[int], torch.dtype]]]:
+        groups: list[list[tuple[str, list[int], torch.dtype]]] = []
+        current: list[tuple[str, list[int], torch.dtype]] = []
+        current_bytes = 0
+
+        for name, dtype_name, shape in zip(update_info.names, update_info.dtype_names, update_info.shapes):
+            dtype = getattr(torch, dtype_name)
+            current.append((name, shape, dtype))
+            if update_info.packed:
+                current_bytes += math.prod(shape) * dtype.itemsize
+                if current_bytes <= update_info.packed_buffer_size_bytes:
+                    continue
+            groups.append(current)
+            current = []
+            current_bytes = 0
+
+        if current:
+            groups.append(current)
+        return groups
+
+    def _tp_broadcast_weight_group(
+        self,
+        group_meta: list[tuple[str, list[int], torch.dtype]],
+        weights: list[tuple[str, torch.Tensor]] | None,
+    ) -> list[tuple[str, torch.Tensor]]:
+        tp_group = get_tp_group()
+        if tp_group.world_size == 1:
+            return [] if weights is None else weights
+
+        relayed: list[tuple[str, torch.Tensor]] = []
+        if tp_group.rank_in_group == 0:
+            if weights is None:
+                raise RuntimeError("leader relay source rank has no weights to broadcast")
+            if len(weights) != len(group_meta):
+                raise RuntimeError(
+                    f"leader relay weight group size mismatch: got {len(weights)}, expected {len(group_meta)}"
+                )
+            for (expected_name, _shape, _dtype), (name, tensor) in zip(group_meta, weights):
+                if name != expected_name:
+                    raise RuntimeError(f"leader relay weight name mismatch: got {name}, expected {expected_name}")
+                tensor = tensor.contiguous()
+                tp_group.broadcast(tensor, src=0)
+                relayed.append((name, tensor))
+        else:
+            for name, shape, dtype in group_meta:
+                tensor = torch.empty(shape, dtype=dtype, device=self.device)
+                tp_group.broadcast(tensor, src=0)
+                relayed.append((name, tensor))
+        return relayed
+
+    def _receive_or_relay_weights(self, update_info, load_weights: Callable[[list[tuple[str, torch.Tensor]]], None]) -> None:
+        groups = self._weight_update_groups(update_info)
+        tp_group = get_tp_group()
+
+        if tp_group.rank_in_group == 0:
+            group_iter = iter(groups)
+
+            def relay_and_load(weights: list[tuple[str, torch.Tensor]]) -> None:
+                try:
+                    group_meta = next(group_iter)
+                except StopIteration as exc:
+                    raise RuntimeError("leader relay received more weight groups than expected") from exc
+                load_weights(self._tp_broadcast_weight_group(group_meta, weights))
+
+            self.weight_transfer_engine.receive_weights(update_info, load_weights=relay_and_load)
+            try:
+                extra = next(group_iter)
+            except StopIteration:
+                pass
+            else:
+                raise RuntimeError(f"leader relay did not receive expected weight group starting at {extra[0][0]}")
+        else:
+            for group_meta in groups:
+                load_weights(self._tp_broadcast_weight_group(group_meta, None))
+
     def finish_weight_update(self) -> None:
         """Finish the current weight update; runs layerwise postprocessing."""
         self._check_weight_transfer_engine()
