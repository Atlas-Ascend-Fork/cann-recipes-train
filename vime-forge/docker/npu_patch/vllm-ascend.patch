@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Shared DeepSeek-V4 lightning-indexer helpers."""
+
+import torch
+
+from vllm_ascend.device.device_op import DeviceOperator
+
+DSV4_MXFP4_QUANT_MODE = 5
+DSV4_LI_CMP_RATIO = 4
+
+
+def build_dsv4_qli_metadata(
+    *,
+    indexer_is_mxfp4: bool = False,
+    num_heads_q: int,
+    num_heads_k: int,
+    head_dim: int,
+    topk: int,
+    cu_seqlens_q: torch.Tensor,
+    seqused_q: torch.Tensor,
+    seqused_k: torch.Tensor,
+    cmp_residual_k: torch.Tensor,
+    batch_size: int,
+):
+    """Build QLI metadata with the cache format selected in one place."""
+    return torch.ops.cann_ops_transformer.quant_lightning_indexer_metadata(
+        num_heads_q,
+        num_heads_k,
+        head_dim,
+        topk,
+        DSV4_MXFP4_QUANT_MODE if indexer_is_mxfp4 else DeviceOperator.get_dsa_indexer_quant_mode(),
+        cu_seqlens_q=cu_seqlens_q,
+        seqused_q=seqused_q,
+        seqused_k=seqused_k,
+        cmp_residual_k=cmp_residual_k,
+        batch_size=batch_size,
+        layout_q="TND",
+        layout_k="PA_BBND",
+        mask_mode=3,
+        # cmp_ratio is the LI CANN operator parameter. It is independent of
+        # the model compressor's compress_ratio and remains fixed at 4 for
+        # both the regular and MXFP4 indexer cache formats.
+        cmp_ratio=DSV4_LI_CMP_RATIO,
+    )
