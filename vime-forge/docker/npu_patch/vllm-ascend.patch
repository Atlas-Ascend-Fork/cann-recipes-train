@@ -0,0 +1,67 @@
+"""DeepSeek V4 mixed MXFP8/MXFP4 quantization configuration for Ascend."""
+
+from typing import Any
+
+import torch
+import torch_npu
+from vllm.model_executor.layers.linear import LinearBase
+from vllm.model_executor.layers.quantization import register_quantization_config
+from vllm.model_executor.layers.quantization.base_config import QuantizeMethodBase
+
+from vllm_ascend.ops.fused_moe.moe_utils import maybe_normalize_mxfp_scale_layout
+
+from .dsv4_mxfp8_config import (
+    _is_fused_moe_layer,
+    AscendDeepseekV4MXFP8Config,
+)
+from .method_adapters import AscendFusedMoEMethod
+from .methods.w4a8.w4a8_mxfp4 import AscendDSW4A8MXFPDynamicFusedMoEMethod
+
+DEEPSEEK_V4_MXFP4_METHOD = "deepseek_v4_mxfp4"
+
+
+@register_quantization_config(DEEPSEEK_V4_MXFP4_METHOD)
+class AscendDeepseekV4MXFP4Config(AscendDeepseekV4MXFP8Config):
+    """Use MXFP8 for ordinary Linear layers and MXFP4 for routed MoE."""
+
+    def __repr__(self) -> str:
+        return "AscendDeepseekV4MXFP4Config:\n" + object.__repr__(self)
+
+    @classmethod
+    def get_name(cls) -> str:
+        return DEEPSEEK_V4_MXFP4_METHOD
+
+    @classmethod
+    def from_config(cls, config: dict[str, Any]) -> "AscendDeepseekV4MXFP4Config":
+        return cls(config)
+
+    @classmethod
+    def override_quantization_method(
+        cls,
+        hf_quant_cfg: dict[str, Any],
+        user_quant: str | None,
+        hf_config: Any = None,
+    ) -> str | None:
+        if not isinstance(hf_quant_cfg, dict):
+            return None
+        if hf_quant_cfg.get("quant_method") != "mxfp8":
+            return None
+        if hf_quant_cfg.get("routed_expert_dtype") != "mxfp4":
+            return None
+        if getattr(hf_config, "model_type", None) == "deepseek_v4":
+            return DEEPSEEK_V4_MXFP4_METHOD
+        return None
+
+    def get_quant_method(
+        self,
+        layer: torch.nn.Module,
+        prefix: str,
+        tid2eid=None,
+    ) -> QuantizeMethodBase | None:
+        if isinstance(layer, LinearBase):
+            return super().get_quant_method(layer, prefix, tid2eid=tid2eid)
+        if _is_fused_moe_layer(layer):
+            layer.ascend_quant_method = DEEPSEEK_V4_MXFP4_METHOD
+            scheme = AscendDSW4A8MXFPDynamicFusedMoEMethod()
+            return AscendFusedMoEMethod(scheme, layer.moe_config, tid2eid=tid2eid)
+        return None
