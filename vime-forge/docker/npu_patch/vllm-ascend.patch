+++ b/vllm_ascend/quantization/dsv4_mxfp8_config.py
@@ -0,0 +1,101 @@
+"""DeepSeek V4 full-MXFP8 quantization configuration for Ascend."""
+
+from typing import Any
+
+import torch
+from vllm.model_executor.layers.linear import LinearBase
+from vllm.model_executor.layers.quantization import register_quantization_config
+from vllm.model_executor.layers.quantization.base_config import QuantizationConfig, QuantizeMethodBase
+
+
+from vllm.model_executor.layers.fused_moe import MoERunner, RoutedExperts
+
+from .method_adapters import AscendFusedMoEMethod, AscendLinearMethod
+from .methods.w8a8.w8a8_mxfp8 import (
+    AscendDSW8A8MXFP8DynamicFusedMoEMethod,
+    AscendDSW8A8MXFP8DynamicLinearMethod,
+)
+
+DEEPSEEK_V4_MXFP8_METHOD = "deepseek_v4_mxfp8"
+
+
+def _is_fused_moe_layer(layer: torch.nn.Module) -> bool:
+    return isinstance(layer, (MoERunner, RoutedExperts))
+
+
+@register_quantization_config(DEEPSEEK_V4_MXFP8_METHOD)
+class AscendDeepseekV4MXFP8Config(QuantizationConfig):
+    """Dispatch DSV4 E4M3/E8M0 checkpoint tensors to Ascend MXFP8 kernels."""
+
+    def __init__(self, config: dict[str, Any] | None = None):
+        super().__init__()
+        self.quant_description = dict(config or {})
+        self.quant_description.setdefault("group_size", 32)
+        self._validate_config()
+
+    def _validate_config(self) -> None:
+        quant_method = self.quant_description.get("quant_method")
+        if quant_method != "mxfp8":
+            raise ValueError(f"Expected quant_method='mxfp8', got {quant_method!r}.")
+        if self.quant_description.get("activation_scheme", "dynamic") != "dynamic":
+            raise ValueError("DeepSeek V4 MXFP8 currently requires dynamic activation quantization.")
+        if self.quant_description.get("fmt", "e4m3").lower() != "e4m3":
+            raise ValueError("DeepSeek V4 MXFP8 currently supports only E4M3 weights.")
+        if self.quant_description.get("scale_fmt", "ue8m0").lower() not in {"ue8m0", "e8m0"}:
+            raise ValueError("DeepSeek V4 MXFP8 currently supports only E8M0 weight scales.")
+        if self.quant_description["group_size"] != 32:
+            raise ValueError("DeepSeek V4 MXFP8 currently supports only group_size=32.")
+
+    def __repr__(self) -> str:
+        return "AscendDeepseekV4MXFP8Config:\n" + super().__repr__()
+
+    @classmethod
+    def get_name(cls) -> str:
+        return DEEPSEEK_V4_MXFP8_METHOD
+
+    @classmethod
+    def get_supported_act_dtypes(cls) -> list[torch.dtype]:
+        return [torch.bfloat16]
+
+    @classmethod
+    def get_min_capability(cls) -> int:
+        raise NotImplementedError('Ascend hardware does not support "get_min_capability".')
+
+    @classmethod
+    def get_config_filenames(cls) -> list[str]:
+        return []
+
+    @classmethod
+    def from_config(cls, config: dict[str, Any]) -> "AscendDeepseekV4MXFP8Config":
+        return cls(config)
+
+    @classmethod
+    def override_quantization_method(
+        cls,
+        hf_quant_cfg: dict[str, Any],
+        user_quant: str | None,
+        hf_config: Any = None,
+    ) -> str | None:
+        if not isinstance(hf_quant_cfg, dict) or hf_quant_cfg.get("quant_method") != "mxfp8":
+            return None
+        if hf_quant_cfg.get("routed_expert_dtype") == "mxfp4":
+            return None
+        model_type = getattr(hf_config, "model_type", None)
+        if model_type == "deepseek_v4":
+            return DEEPSEEK_V4_MXFP8_METHOD
+        return None
+
