+def test_first_schedule_tracks_cow_before_post_schedule_hook():
+    manager = make_manager()
+    pool, kv = make_unbound_block_pool(manager)
+    group = kv.coordinator.single_type_managers[0]
+    group.copies = []
+    group.take_pending_cow_copies = lambda: group.copies
+
+    class Base:
+        def __init__(self):
+            self.kv_cache_manager = kv
+            self.routed_experts_mgr = manager
+            self.requests = {"b": SimpleNamespace(num_preemptions=0)}
+
+        def schedule(self):
+            pass
+
+        def _update_after_schedule(self, output):
+            pass
+
+        def _preempt_request(self, request, timestamp, drop_stale_output=False):
+            pass
+
+        def update_from_output(self, scheduled, output):
+            pass
+
+    class CustomScheduler(Base):
+        def schedule(self):
+            source, target = pool.get_new_blocks(2)
+            self.source, self.target = source.block_id, target.block_id
+            group.copies = [(source, target)]
+            group.take_pending_cow_copies()
+            # Real schedulers drain CoW before entering the post-schedule hook.
+            assert manager._pending_copies[self.target] == (self.source, 1, 1, None)
+            output = SimpleNamespace(
+                scheduled_token_start={"b": 2}, routed_experts_block_ids={"b": [self.target]},
+            )
+            self._update_after_schedule(output)
+            return output
+
+    capture_patch._patch_scheduler_routing_lifecycle(Base)
+    scheduler = CustomScheduler()
+    scheduler.schedule()
+    assert manager._pending_copies[scheduler.target] == (scheduler.source, 1, 1, 2)
+    manager.store_request_range([scheduler.source], 0, rows(0, 2))
+    manager.resolve_copies()
+    np.testing.assert_array_equal(manager.get([scheduler.target], 2, request_id="b"), rows(0, 2))
