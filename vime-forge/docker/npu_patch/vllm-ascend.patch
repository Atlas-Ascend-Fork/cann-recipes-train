--- /dev/null
+++ b/vllm_ascend/patch/worker/patch_process_weights_after_loading.py
@@ -0,0 +1,54 @@
+import torch
+import torch_npu
+from torch import nn
+from vllm.model_executor.model_loader.reload import layerwise
+
+ACL_FORMAT_FRACTAL_NZ = 29
+ACL_FORMAT_FRACTAL_NZ_C0_16 = 50
+
+# Keep vLLM's normal reload behavior for every existing quantization path.
+# The physical NZ copy is needed only by the DSV4 MXFP4 routed-expert path.
+_original_copy_and_restore_kernel_tensors = layerwise._copy_and_restore_kernel_tensors
+
+
+def _copy_reloaded_tensor(dst: torch.Tensor, src: torch.Tensor) -> None:
+    if dst.device.type != "npu" or torch_npu.get_npu_format(dst) not in (
+        ACL_FORMAT_FRACTAL_NZ,
+        ACL_FORMAT_FRACTAL_NZ_C0_16,
+    ):
+        dst.copy_(src)
+        return
+    if (
+        dst.device != src.device
+        or dst.dtype != src.dtype
+        or dst.shape != src.shape
+        or dst.stride() != src.stride()
+        or dst.storage_offset() != 0
+        or src.storage_offset() != 0
+        or torch_npu.get_npu_format(dst) != torch_npu.get_npu_format(src)
+        or dst.untyped_storage().nbytes() != src.untyped_storage().nbytes()
+    ):
+        raise ValueError("NZ weight reload requires identical device, dtype, shape and physical storage layout")
+    torch_npu.copy_memory_(dst, src)
+
+
+def _copy_and_restore_kernel_tensors(layer: nn.Module, info) -> None:
+    if getattr(layer, "ascend_quant_method", None) != "deepseek_v4_mxfp4":
+        _original_copy_and_restore_kernel_tensors(layer, info)
+        return
+    assert info.kernel_tensors is not None
+    parameters, buffers = info.kernel_tensors
+    non_persistent = info.kernel_non_persistent_buffers
+    loaded_tensor_names = {name for name, _ in info.loaded_weights}
+    for name, param in parameters.items():
+        _copy_reloaded_tensor(param.data, getattr(layer, name))
+    for name, buffer in buffers.items():
+        if name not in layer._buffers:
+            continue
+        if name in non_persistent and name not in loaded_tensor_names:
+            continue
+        _copy_reloaded_tensor(buffer.data, getattr(layer, name))
+    layerwise._place_kernel_tensors(layer, info)
+
+
+layerwise._copy_and_restore_kernel_tensors = _copy_and_restore_kernel_tensors
