+from __future__ import annotations
+
+from copy import copy
+from functools import wraps
+
+import numpy as np
+from vllm.config import VllmConfig
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe.routed_experts_capturer import RoutedExpertsManager
+from vllm.v1.kv_cache_interface import KVCacheConfig, UniformTypeKVCacheSpecs
+
+logger = init_logger(__name__)
+
+
+class AscendRoutedExpertsManager(RoutedExpertsManager):
+    """Native slot storage with Ascend tail and async-ownership safeguards.
+
+    The base class owns model shape, dtype, allocation and slot I/O. This
+    adapter validates physical ownership and retains unavailable tail rows.
+    """
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        kv_cache_config: KVCacheConfig,
+    ) -> None:
+        super().__init__(vllm_config, kv_cache_config)
+        spec = kv_cache_config.kv_cache_groups[self.attn_gid].kv_cache_spec
+        if isinstance(spec, UniformTypeKVCacheSpecs):
+            spec = next(iter(spec.kv_cache_specs.values()))
+        # Modern specs already count original tokens. Only legacy compressed
+        # specs need a larger routed block than the native allocation.
+        ratio = max(getattr(spec, "compress_ratio", 1), 1)
+        self.block_size *= ratio
+        self.routed_token_block_size = self.block_size
+        if ratio != 1:
+            self.routed_experts_by_slot = np.zeros(
+                (kv_cache_config.num_blocks * self.block_size, *self.routed_experts_by_slot.shape[1:]),
+                dtype=self.routed_experts_by_slot.dtype,
+            )
+        max_num_slots = self.routed_experts_by_slot.shape[0]
+        self._valid_routing_slots = np.zeros(max_num_slots, dtype=np.bool_)
+        self._block_pool = None
+        self._block_generations = np.zeros(kv_cache_config.num_blocks, dtype=np.uint64)
+        self._pending_block_generations: dict[str, np.ndarray] = {}
+        # destination -> (source, source generation, destination generation,
+        #                 prefix rows to copy; None until schedule is recorded)
+        self._pending_copies: dict[int, tuple[int, int, int, int | None]] = {}
+        self._pending_routed_experts = {}
+        self._pending_write_limits: dict[str, int | None] = {}
+        self._stale_prompt_routing: dict[tuple[str, int], np.ndarray] = {}
+        # Native num_preemptions identifies one execution of a request.
+        self._routing_progress: dict[tuple[str, int], tuple[int, int]] = {}
+        self._routing_inflight: dict[tuple[str, int], int] = {}
+        self._routing_context: dict[str, tuple[tuple[str, int], int]] = {}
+        # Missing old prompt rows: original slots, generations, ready mask.
+        self._deferred_prompts: dict[tuple[str, int], tuple[np.ndarray, np.ndarray, np.ndarray]] = {}
+
+    def bind_kv_cache_manager(self, kv_cache_manager) -> None:
+        """Follow physical allocation and CoW without invalidating prefix hits."""
+        pool = kv_cache_manager.block_pool
+        if self._block_pool is pool:
+            return
+        if self._block_pool is not None:
+            raise RuntimeError("Routed-experts manager cannot switch KV block pools")
+        self._block_pool = pool
+        original_allocate = pool.get_new_blocks
+
+        @wraps(original_allocate)
+        def get_new_blocks(num_blocks):
+            blocks = original_allocate(num_blocks)
+            # Preserve any ready CoW rows before their source is recycled.
+            self.resolve_copies()
+            bs = self.routed_token_block_size
+            for block in blocks:
+                self._block_generations[block.block_id] += 1
+                start = block.block_id * bs
+                self._valid_routing_slots[start : start + bs] = False
+            return blocks
+
+        # Freeing a request or touching a prefix hit does not overwrite KV.
+        # Invalidate only when the pool actually hands out a block for new KV.
+        pool.get_new_blocks = get_new_blocks
+        group = kv_cache_manager.coordinator.single_type_managers[self.attn_gid]
+        original_copies = group.take_pending_cow_copies
+
+        @wraps(original_copies)
+        def take_pending_cow_copies():
+            copies = original_copies()
+            for source, destination in copies:
+                src, dst = source.block_id, destination.block_id
+                self._pending_copies[dst] = (
+                    src, int(self._block_generations[src]), int(self._block_generations[dst]), None
+                )
+            return copies
+
+        group.take_pending_cow_copies = take_pending_cow_copies
+
+    def record_schedule(self, scheduler_output, requests=None) -> None:
+        """Snapshot ownership once for each asynchronous forward."""
+        if hasattr(scheduler_output, "_ascend_routing_keys"):
+            return
+        snapshots, keys = {}, {}
+        bs = self.routed_token_block_size
+        starts = scheduler_output.scheduled_token_start or {}
+        for request_id, blocks in (scheduler_output.routed_experts_block_ids or {}).items():
+            request = requests.get(request_id) if requests is not None else None
+            key = (request_id, getattr(request, "num_preemptions", 0))
+            keys[request_id] = key
+            self._routing_inflight[key] = self._routing_inflight.get(key, 0) + 1
+            self._routing_progress.setdefault(key, (starts[request_id], starts[request_id]))
+            snapshots[request_id] = self._block_generations[np.asarray(blocks, dtype=np.int64)].copy()
+            for index, block_id in enumerate(blocks):
+                pending = self._pending_copies.get(block_id)
+                if pending is not None and pending[3] is None:
+                    src, src_gen, dst_gen, _ = pending
+                    prefix_rows = min(bs, max(0, starts[request_id] - index * bs))
+                    self._pending_copies[block_id] = (src, src_gen, dst_gen, prefix_rows)
+        # SchedulerOutput stays alive with its own async forward; a request-ID
+        # map alone would be overwritten by the next scheduled step.
+        scheduler_output._ascend_routing_generations = snapshots
+        scheduler_output._ascend_routing_keys = keys
+
+    def resolve_copies(self) -> None:
+        """Fill CoW prefixes when CPU routing arrives, following copy chains."""
+        bs = self.routed_token_block_size
+        progress = True
+        while progress and self._pending_copies:
+            progress = False
+            for dst, (src, src_gen, dst_gen, count) in list(self._pending_copies.items()):
+                if self._block_generations[src] != src_gen or self._block_generations[dst] != dst_gen:
+                    # Neither a recycled source nor a recycled destination
+                    # belongs to this copy, even if its expert IDs are nonzero.
+                    self._pending_copies.pop(dst)
+                    progress = True
+                    continue
+                if count is None:
+                    continue
+                src_slots = np.arange(src * bs, src * bs + count)
+                dst_slots = np.arange(dst * bs, dst * bs + count)
+                ready = self._valid_routing_slots[src_slots] & ~self._valid_routing_slots[dst_slots]
+                if ready.any():
+                    # Never replace a destination row from its newer forward.
+                    super().store_batch(self.routed_experts_by_slot[src_slots[ready]], dst_slots[ready])
+                    self._valid_routing_slots[dst_slots[ready]] = True
+                    progress = True
+                if self._valid_routing_slots[dst_slots].all():
+                    self._pending_copies.pop(dst)
+                    progress = True
+
+    def capture_stale_prompt(self, key, blocks: list[int], processed: int) -> None:
+        self.resolve_copies()
+        shape = (processed, *self.routed_experts_by_slot.shape[1:])
+        rows = np.zeros(shape, dtype=self.routed_experts_by_slot.dtype)
+        slots = np.full(processed, -1, dtype=np.int64)
+        generations = np.zeros(processed, dtype=np.uint64)
+        ready = np.zeros(processed, dtype=np.bool_)
+        covered = min(processed, len(blocks) * self.block_size)
+        physical, _ = self._slots(blocks, 0, covered)
+        slots[:covered] = physical
+        generations[:covered] = self._block_generations[physical // self.block_size]
+        ready[:covered] = self._valid_routing_slots[physical]
+        rows[:covered][ready[:covered]] = self.routed_experts_by_slot[physical[ready[:covered]]]
+        pending = self._pending_routed_experts.get(key[0])
+        if pending is not None:
+            start, tail = pending
+            end = min(processed, start + len(tail))
+            if start < end:
+                rows[start:end], ready[start:end] = tail[: end - start], True
+        if ((slots < 0) & ~ready).any():
+            raise RuntimeError(f"routed-experts stale prompt range is not covered: req={key[0]}")
+        # An unready CoW destination needs the original source generation even
+        # if both physical endpoints are recycled before the CPU result arrives.
+        for _ in range(len(self._pending_copies) + 1):
+            changed = False
+            for dst, (src, src_gen, dst_gen, count) in self._pending_copies.items():
+                if count is None:
+                    continue
+                match = ~ready & (slots // self.block_size == dst) & (generations == dst_gen)
+                match &= slots % self.block_size < count
+                if match.any():
+                    slots[match] = src * self.block_size + slots[match] % self.block_size
+                    generations[match] = src_gen
+                    changed = True
+            if not changed:
+                break
+        self._stale_prompt_routing[key] = rows
+        if not ready.all():
+            self._deferred_prompts[key] = (slots, generations, ready)
+
+    def _supply_deferred_prompts(self, slots, generations, data) -> None:
+        if not len(slots) or not self._deferred_prompts:
+            return
+        order = np.argsort(slots)
+        for key, (wanted, expected, ready) in list(self._deferred_prompts.items()):
+            missing = np.flatnonzero(~ready)
+            found = np.searchsorted(slots[order], wanted[missing])
+            in_range = found < len(order)
+            missing, found = missing[in_range], order[found[in_range]]
+            match = (slots[found] == wanted[missing]) & (generations[found] == expected[missing])
+            target, source = missing[match], found[match]
+            self._stale_prompt_routing[key][target] = data[source]
+            ready[target] = True
+            if ready.all():
+                self._deferred_prompts.pop(key)
+
+    def finish_step(self, keys, requests) -> None:
+        for request_id, key in keys.items():
+            remaining = self._routing_inflight[key] - 1
+            if remaining:
+                self._routing_inflight[key] = remaining
+                continue
+            self._routing_inflight.pop(key)
+            request = requests.get(request_id)
+            if request is None or request.num_preemptions != key[1] or request.is_finished():
+                self._routing_progress.pop(key, None)
+                self._stale_prompt_routing.pop(key, None)
+                self._deferred_prompts.pop(key, None)
+
+    def store_batch(self, data: np.ndarray, slot_mapping: np.ndarray) -> None:
+        # Native update_from_output still calls this after our range writes.
+        # Admit that exact call once; unvalidated raw slots must never be used.
+        expected = getattr(self, "_expected_store_batch", None)
+        if expected is None or expected.routing_data is not data or expected.slot_mapping is not slot_mapping:
+            raise RuntimeError("raw routed-experts slot writes require scheduler range validation")
+        self._expected_store_batch = None
+
+    def update_pending(
+        self,
+        request_id: str,
+        token_start: int,
+        data: np.ndarray,
+        block_ids: list[int] | None = None,
+    ) -> None:
+        """Retain incomplete tails and mirror their allocated rows safely."""
+        if data.shape[0] == 0:
+            return
+        if token_start < 0:
+            raise ValueError(f"Invalid routed-experts token range: start={token_start}")
+        if request_id in self._pending_write_limits:
+            valid_tokens = self._pending_write_limits[request_id]
+            if valid_tokens is None:
+                key, accepted = self._routing_context.get(request_id, ((request_id, 0), len(data)))
+                data = data[:accepted]
+                # This output belongs to a preempted execution. Its block
+                # snapshot must not repopulate the new execution's routing.
+                previous = self._stale_prompt_routing.get(key)
+                if previous is not None:
+                    if token_start > previous.shape[0]:
+                        raise RuntimeError(f"routed-experts stale prompt token range has a gap: req={request_id}")
+                    self._stale_prompt_routing[key] = np.concatenate((previous[:token_start], data), axis=0)
+                return
+            data = data[:valid_tokens]
+
+        token_end = token_start + data.shape[0]
+        pending = self._pending_routed_experts.get(request_id)
+        if pending is None:
+            pending_start, pending_data = token_start, data.copy()
+        else:
+            pending_start, pending_data = pending
+            pending_end = pending_start + pending_data.shape[0]
+            if token_start > pending_end:
+                # One pending suffix cannot represent a hole. Keep the old
+                # state intact rather than losing rows or shifting positions.
+                raise RuntimeError(f"routed-experts pending gap: req={request_id}, range=[{pending_end},{token_start})")
+            if block_ids and token_end < pending_end:
+                # A recomputed shorter suffix also invalidates its old mirror.
+                end = min(pending_end, len(block_ids) * self.block_size)
+                slots, _ = self._slots(block_ids, token_end, end)
+                self._valid_routing_slots[slots] = False
+            if token_start <= pending_start:
+                # A recomputation can restart before the retained suffix.
+                pending_start, pending_data = token_start, data.copy()
+            else:
+                # The new forward supersedes overlapping rows. Do not keep
+                # the old suffix beyond token_end after a speculative rollback.
+                pending_data = np.concatenate((pending_data[: token_start - pending_start], data), axis=0)
+
+        # Persist all allocated rows once, including a partial CoW prefix.
+        # Drop only completed, persisted blocks; unavailable rows stay pending.
+        complete_end = token_end // self.block_size * self.block_size
+        capacity = len(block_ids or []) * self.block_size
+        if block_ids and complete_end > max(capacity, pending_start):
+            raise RuntimeError("routed-experts block snapshot is shorter than token range")
+        available_end = min(token_end, capacity)
+        if available_end > pending_start:
+            self.store_request_range(
+                block_ids, pending_start, pending_data[: available_end - pending_start],
+                block_generations=self._pending_block_generations.get(request_id),
+            )
+            flushed_end = min(available_end, complete_end)
+            flushed = max(0, flushed_end - pending_start)
+            pending_start, pending_data = pending_start + flushed, pending_data[flushed:]
+        if len(pending_data):
+            self._pending_routed_experts[request_id] = (pending_start, pending_data)
+        else:
+            self._pending_routed_experts.pop(request_id, None)
+
+    def _slots(self, block_ids: list[int], start: int, end: int) -> tuple[np.ndarray, np.ndarray]:
+        """Validate a logical range before passing its slots to native I/O."""
+        if start < 0:
+            raise ValueError(f"Invalid routed-experts token range: start={start}")
+        positions = np.arange(start, end, dtype=np.int64)
+        indices = positions // self.block_size
+        ids = np.asarray(block_ids, dtype=np.int64)
+        if indices.size and indices[-1] >= ids.size:
+            raise RuntimeError("routed-experts block snapshot is shorter than token range")
+        slots = ids[indices] * self.block_size + positions % self.block_size
+        if slots.size and (slots.min() < 0 or slots.max() >= self.routed_experts_by_slot.shape[0]):
+            raise RuntimeError("routed-experts block snapshot contains invalid block IDs")
+        return slots, indices
+
+    def store_request_range(
+        self,
+        block_ids: list[int],
+        token_start: int,
+        data: np.ndarray,
+        *,
+        block_generations: np.ndarray | None = None,
+    ) -> None:
+        """Validate ownership, then delegate bulk storage to vLLM."""
+        if not len(data):
+            return
+        slots, indices = self._slots(block_ids, token_start, token_start + len(data))
+        current = self._block_generations[slots // self.block_size]
+        generations = current
+        if block_generations is not None:
+            if indices[-1] >= len(block_generations):
+                raise RuntimeError("routed-experts generation snapshot is shorter than token range")
+            generations = block_generations[indices]
+        self._supply_deferred_prompts(slots, generations, data)
+        owned = current == generations
+        slots, data = slots[owned], data[owned]
+        super().store_batch(data, slots)
+        self._valid_routing_slots[slots] = True
+
+    def take_pending(self, request_id: str) -> tuple[int, np.ndarray] | None:
+        """Return the retained suffix without consuming it.
+
+        Keep the legacy accessor name; only persistence or request cleanup
+        may discard these rows.
+        """
+        return self._pending_routed_experts.get(request_id)
+
+    def discard_pending(self, request_id: str) -> None:
+        """Drop transient routing state when a request leaves the scheduler."""
+        self._pending_routed_experts.pop(request_id, None)
+        for key in list(self._stale_prompt_routing):
+            if key[0] == request_id:
+                self._stale_prompt_routing.pop(key)
+                self._deferred_prompts.pop(key, None)
+        for key in list(self._routing_progress):
+            if key[0] == request_id and key not in self._routing_inflight:
+                self._routing_progress.pop(key)
+
+    def get(
+        self,
+        block_ids: list[int],
+        num_tokens: int,
+        token_start: int = 0,
+        request_id: str | None = None,
+    ) -> np.ndarray:
+        """Validate the persistent prefix, then merge a non-consuming tail."""
+        if not 0 <= token_start <= num_tokens:
+            raise ValueError(f"Invalid routed-experts token range: start={token_start}, end={num_tokens}")
+        # Reading the first prefill output does not finish the request. Keep
+        # its partial block until decode persists it or the scheduler discards it.
+        pending = self.take_pending(request_id) if request_id is not None else None
+        if request_id in self._pending_write_limits and self._pending_write_limits[request_id] is None:
+            # A stale prefill output may still be delivered to the frontend.
+            # Reconstruct it from a CPU snapshot, never from freed KV slots.
+            key = self._routing_context.get(request_id, ((request_id, 0), 0))[0]
+            stale = self._stale_prompt_routing.get(key)
+            if stale is None:
+                raise RuntimeError(f"routed-experts stale prompt snapshot is missing: req={request_id}")
+            waiting = self._deferred_prompts.get(key)
+            if waiting is not None and not waiting[2][token_start:num_tokens].all():
+                raise RuntimeError(f"routed-experts stale prompt routing is not ready: req={request_id}")
+            pending = (0, stale)
+        persistent_tokens = min(pending[0], num_tokens) if pending is not None else num_tokens
+        slots, indices = self._slots(block_ids, token_start, persistent_tokens)
+        self.resolve_copies()
+        generations = self._pending_block_generations.get(request_id)
+        if indices.size and generations is not None:
+            if indices[-1] >= len(generations) or not np.array_equal(
+                self._block_generations[slots // self.block_size], generations[indices]
+            ):
+                raise RuntimeError(f"routed-experts block generation changed before read: req={request_id}")
+        valid = self._valid_routing_slots[slots]
+        if not valid.all():
+            raise RuntimeError(f"unwritten routed-experts slots: req={request_id}, count={int((~valid).sum())}")
+        result = super().get(block_ids, persistent_tokens, token_start, request_id)
+        if pending is not None:
+            pending_start, pending_data = pending
+            tail_start = max(pending_start, token_start + result.shape[0])
+            tail_end = min(num_tokens, pending_start + pending_data.shape[0])
+            if tail_start < tail_end:
+                result = np.concatenate(
+                    (result, pending_data[tail_start - pending_start : tail_end - pending_start]),
+                    axis=0,
+                )
+        if result.shape[0] != num_tokens - token_start:
+            raise RuntimeError(
+                "routed-experts token range is not fully covered: "
+                f"req={request_id}, range=[{token_start},{num_tokens}), rows={result.shape[0]}"
+            )
+        return result
+
+
+def _patch_scheduler_routing_lifecycle(scheduler_cls):
+    """Keep transient routing aligned with preemption and accepted forwards."""
+    # An exported Scheduler may be replaced by an Ascend subclass, while
+    # AsyncScheduler still inherits its original base. Patch that common base
+    # as well; inherited method markers keep the installation idempotent.
+    for base in scheduler_cls.__bases__:
+        if hasattr(base, "_preempt_request"):
+            _patch_scheduler_routing_lifecycle(base)
+    # Ascend schedulers can replace schedule() without calling super().
+    # Their constructors and post-schedule hooks still use the native base.
+    original_init = scheduler_cls.__init__
+    if not getattr(original_init, "_ascend_routing_lifecycle", False):
+
+        @wraps(original_init)
+        def init(self, *args, **kwargs):
+            original_init(self, *args, **kwargs)
+            manager = getattr(self, "routed_experts_mgr", None)
+            if isinstance(manager, AscendRoutedExpertsManager):
+                manager.bind_kv_cache_manager(self.kv_cache_manager)
+
+        init._ascend_routing_lifecycle = True
+        scheduler_cls.__init__ = init
+
+    original_after_schedule = getattr(scheduler_cls, "_update_after_schedule", None)
+    if original_after_schedule is not None and not getattr(
+        original_after_schedule, "_ascend_routing_lifecycle", False
+    ):
+
+        @wraps(original_after_schedule)
+        def update_after_schedule(self, output, *args, **kwargs):
+            result = original_after_schedule(self, output, *args, **kwargs)
+            manager = getattr(self, "routed_experts_mgr", None)
+            if isinstance(manager, AscendRoutedExpertsManager):
+                manager.record_schedule(output, self.requests)
+            return result
+
+        update_after_schedule._ascend_routing_lifecycle = True
+        scheduler_cls._update_after_schedule = update_after_schedule
+
+    # Compatibility fallback; bind and record_schedule are both idempotent.
+    original_schedule = getattr(scheduler_cls, "schedule", None)
+    if original_schedule is not None and not getattr(original_schedule, "_ascend_routing_lifecycle", False):
+
+        @wraps(original_schedule)
+        def schedule(self, *args, **kwargs):
+            manager = getattr(self, "routed_experts_mgr", None)
+            if isinstance(manager, AscendRoutedExpertsManager):
+                manager.bind_kv_cache_manager(self.kv_cache_manager)
+            output = original_schedule(self, *args, **kwargs)
+            if isinstance(manager, AscendRoutedExpertsManager):
+                manager.record_schedule(output, self.requests)
+            return output
+
+        schedule._ascend_routing_lifecycle = True
+        scheduler_cls.schedule = schedule
+
+    original_preempt = scheduler_cls._preempt_request
+    if not getattr(original_preempt, "_ascend_routing_lifecycle", False):
+
+        @wraps(original_preempt)
+        def preempt_request(self, request, timestamp, drop_stale_output=False):
+            manager = getattr(self, "routed_experts_mgr", None)
+            if isinstance(manager, AscendRoutedExpertsManager):
+                key = (request.request_id, request.num_preemptions)
+                dropping = drop_stale_output or (
+                    request.drop_stale_output and request.num_stale_output_tokens > 0
+                )
+                if request.num_in_flight_tokens > 0 and not request.output_token_ids and not dropping:
+                    if key not in manager._stale_prompt_routing:
+                        processed = manager._routing_progress.get(
+                            key, (request.num_computed_tokens - request.num_in_flight_tokens, 0)
+                        )[0]
+                        try:
+                            groups = self.kv_cache_manager.get_blocks(request.request_id).get_block_ids()
+                            blocks = groups[manager.attn_gid]
+                            manager.capture_stale_prompt(key, blocks, processed)
+                        except (RuntimeError, ValueError, IndexError) as exc:
+                            # The caller has already removed the request from
+                            # running. Complete native preemption, but do not
+                            # deliver an old output whose routing was lost.
+                            manager._stale_prompt_routing.pop(key, None)
+                            manager._deferred_prompts.pop(key, None)
+                            drop_stale_output = True
+                            logger.warning(
+                                "Cannot preserve routed-experts prompt for request %s; "
+                                "dropping in-flight output and recomputing after preemption: %s",
+                                request.request_id, exc,
+                            )
+            result = original_preempt(self, request, timestamp, drop_stale_output=drop_stale_output)
+            if isinstance(manager, AscendRoutedExpertsManager):
+                manager._pending_routed_experts.pop(request.request_id, None)
+                if key not in manager._routing_inflight:
+                    manager._routing_progress.pop(key, None)
+            return result
+
+        preempt_request._ascend_routing_lifecycle = True
+        scheduler_cls._preempt_request = preempt_request
+
+    original_update = scheduler_cls.update_from_output
+    if getattr(original_update, "_ascend_routing_lifecycle", False):
+        return
+
+    @wraps(original_update)
+    def update_from_output(self, scheduler_output, model_runner_output):
+        manager = getattr(self, "routed_experts_mgr", None)
+        if not isinstance(manager, AscendRoutedExpertsManager):
+            return original_update(self, scheduler_output, model_runner_output)
+        keys = getattr(scheduler_output, "_ascend_routing_keys", {})
+        if model_runner_output.routed_experts is None:
+            try:
+                return original_update(self, scheduler_output, model_runner_output)
+            finally:
+                manager.finish_step(keys, self.requests)
+
+        previous_limits = manager._pending_write_limits
+        previous_generations = manager._pending_block_generations
+        previous_context = manager._routing_context
+        previous_batch = getattr(manager, "_expected_store_batch", None)
+        contexts, starts = {}, dict(scheduler_output.scheduled_token_start or {})
+        manager._routing_context = contexts
+        limits: dict[str, int | None] = {}
+        snapshots = getattr(scheduler_output, "_ascend_routing_generations", {})
+        manager._pending_write_limits, manager._pending_block_generations = limits, snapshots
+        try:
+            data = model_runner_output.routed_experts.routing_data
+            offset = 0
+            for request_id in model_runner_output.req_ids:
+                count = scheduler_output.num_scheduled_tokens[request_id]
+                valid = count
+                drafts = scheduler_output.scheduled_spec_decode_tokens.get(request_id)
+                if drafts:
+                    index = model_runner_output.req_id_to_index[request_id]
+                    sampled = model_runner_output.sampled_token_ids
+                    generated = sampled[index] if sampled else []
+                    if generated or self.num_sampled_tokens_per_step == 0:
+                        accepted = max(len(generated) - self.num_sampled_tokens_per_step, 0)
+                        valid -= len(drafts) - accepted
+                        if not 0 <= valid <= count:
+                            raise RuntimeError(f"Invalid routed-experts accepted token count: req={request_id}")
+                key = keys.get(request_id, (request_id, 0))
+                start = starts[request_id]
+                cursor, scheduled_end = manager._routing_progress.get(key, (start, start))
+                if start > cursor and cursor < scheduled_end:
+                    # Like native auxiliary output capture: a prior rejection
+                    # rebases an already-scheduled optimistic suffix.
+                    start = cursor
+                elif start != cursor:
+                    raise RuntimeError(f"routed-experts accepted cursor mismatch: req={request_id}")
+                manager._routing_progress[key] = (start + valid, starts[request_id] + count)
+                starts[request_id] = start
+                contexts[request_id] = (key, valid)
+                request = self.requests.get(request_id)
+                if request is not None and request.num_stale_output_tokens > 0:
+                    limits[request_id] = None
+                elif drafts:
+                    limits[request_id] = valid
+                if request_id in snapshots:
+                    blocks = scheduler_output.routed_experts_block_ids[request_id]
+                    covered = max(0, len(blocks) * manager.block_size - start)
+                    manager.store_request_range(
+                        blocks, start, data[offset : offset + min(valid, covered)],
+                        block_generations=snapshots[request_id],
+                    )
+                offset += count
+            # Publish the whole batch before assembling any prefix consumer.
+            manager.resolve_copies()
+            adjusted = copy(scheduler_output)
+            adjusted.scheduled_token_start = starts
+            manager._expected_store_batch = model_runner_output.routed_experts
+            return original_update(self, adjusted, model_runner_output)
+        finally:
+            manager._pending_write_limits = previous_limits
+            manager._pending_block_generations = previous_generations
+            manager._routing_context = previous_context
+            manager._expected_store_batch = previous_batch
+            manager.finish_step(keys, self.requests)
+
+    update_from_output._ascend_routing_lifecycle = True
+    scheduler_cls.update_from_output = update_from_output
+
+
+from vllm.v1.core.sched.async_scheduler import AsyncScheduler  # noqa: E402
+from vllm.v1.core.sched.scheduler import Scheduler  # noqa: E402
+
+_patch_scheduler_routing_lifecycle(Scheduler)
+_patch_scheduler_routing_lifecycle(AsyncScheduler)
