+def make_scheduler(manager):
+    class Scheduler:
+        def _preempt_request(self, request, timestamp, drop_stale_output=False):
+            request.num_computed_tokens = 0
+            request.num_stale_output_tokens = 3
+            request.num_preemptions += 1
+            return "preempted"
+
+        def update_from_output(self, scheduler_output, model_runner_output):
+            for rid in scheduler_output.num_scheduled_tokens:
+                self.routed_experts_mgr.update_pending(
+                    rid,
+                    scheduler_output.scheduled_token_start[rid],
+                    model_runner_output.routed_experts.routing_data,
+                    scheduler_output.routed_experts_block_ids[rid],
+                )
+            return "updated"
+
+    capture_patch._patch_scheduler_routing_lifecycle(Scheduler)
+    capture_patch._patch_scheduler_routing_lifecycle(Scheduler)
+    scheduler = Scheduler()
+    scheduler.routed_experts_mgr = manager
+    scheduler.requests = {
+        "r": SimpleNamespace(
+            request_id="r",
+            num_preemptions=0,
+            drop_stale_output=False,
+            is_finished=lambda: False,
+            num_stale_output_tokens=0,
+            num_computed_tokens=3,
+            num_in_flight_tokens=0,
+            output_token_ids=[],
+        )
+    }
+    scheduler.num_sampled_tokens_per_step = 1
+    return scheduler
