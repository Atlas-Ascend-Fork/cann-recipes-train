+class ElasticBufferTokenDispatcher(MoETokenDispatcher[ElasticCombineMetadata]):
+    """Token dispatcher backed by the A5 ElasticBuffer API."""
+
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        from cann_ops_transformer import ElasticBuffer
+
+        global _DSV4_ELASTIC_BUFFER
+        vllm_config = get_current_vllm_config()
+        ep_group = get_dsv4_elastic_group()
+        hf_config = vllm_config.model_config.hf_text_config
+        self._row_ids_cache: dict[tuple[str, int | None, int], torch.Tensor] = {}
+
+        # The prepare stage may slice tokens across TP ranks.
+        max_num_batched_tokens = vllm_config.scheduler_config.max_num_batched_tokens
+        tp_size = vllm_config.parallel_config.tensor_parallel_size
+        max_tokens = (max_num_batched_tokens + tp_size - 1) // tp_size
+
+        if _DSV4_ELASTIC_BUFFER is None:
+            _DSV4_ELASTIC_BUFFER = ElasticBuffer(
+                ep_group.device_group,
+                num_max_tokens_per_rank=max_tokens,
+                hidden=hf_config.hidden_size,
+                num_topk=self.top_k,
+            )
+        self.elastic_buffer = _DSV4_ELASTIC_BUFFER
+
+    def _get_row_ids(self, num_rows: int, device: torch.device) -> torch.Tensor:
+        key = (device.type, device.index, num_rows)
+        row_ids = self._row_ids_cache.get(key)
+        if row_ids is None:
+            row_ids = torch.arange(num_rows, dtype=torch.int64, device=device)
+            self._row_ids_cache[key] = row_ids
+        return row_ids
+
+    def token_dispatch(self, token_dispatch_input: MoETokenDispatchInput):
+        if token_dispatch_input.routing.log2phy is not None:
+            raise NotImplementedError("ElasticBuffer does not support EPLB expert remapping.")
+
+        dispatch_x = token_dispatch_input.hidden_states
+        dispatch_scale = token_dispatch_input.routing.pertoken_scale
+        topk_ids = token_dispatch_input.topk_ids.to(torch.int32).contiguous()
+        topk_weights = token_dispatch_input.topk_weights.to(torch.float32).contiguous()
+
+        original_tokens = dispatch_x.shape[0]
+        if dispatch_x.dtype in (torch.float8_e4m3fn, torch.float8_e5m2):
+            if dispatch_scale is None:
+                raise RuntimeError("FP8 ElasticBuffer dispatch requires per-token scales.")
+            elastic_input = (dispatch_x.contiguous(), dispatch_scale.contiguous())
+        elif dispatch_x.dtype in (torch.bfloat16, torch.float16):
+            elastic_input = dispatch_x.contiguous()
+        else:
+            raise RuntimeError("DSV4 ElasticBuffer requires BF16/FP16 or FP8 activations with scale.")
+
+        recv_x, _, recv_weights, handle = self.elastic_buffer.dispatch(
+            elastic_input,
+            topk_idx=topk_ids,
+            topk_weights=topk_weights,
+            num_experts=self.num_experts,
+            do_cpu_sync=_elastic_has_prefill(get_forward_context().attn_metadata),
+        )
+        recv_weights = recv_weights.view(-1, 1)
+        dynamic_scale = None
+        if isinstance(recv_x, tuple):
+            recv_x, dynamic_scale = recv_x
+        return MoETokenDispatchOutput(
+            hidden_states=recv_x,
+            dynamic_scale=dynamic_scale,
+            group_list=handle.num_recv_tokens_per_expert,
+            group_list_type=EXPERT_TOKEN_NUMS_TYPE_COUNT,
+            combine_metadata=ElasticCombineMetadata(handle, recv_weights, original_tokens),
+            topk_scales=recv_weights,
+        )
+
+    def token_combine(self, hidden_states, combine_metadata, bias=None):
+        assert bias is None, "Bias is not supported by ElasticBuffer."
+        handle = combine_metadata.handle
+        actual_rows = handle.num_recv_tokens_per_expert.sum()
+        row_ids = self._get_row_ids(hidden_states.shape[0], hidden_states.device)
+        valid_rows = (row_ids < actual_rows).unsqueeze(-1)
+        hidden_states.masked_fill_(~valid_rows, 0)
+        handle.recv_src_metadata.masked_fill_(~valid_rows, 0)
+
+        combined_output, _ = self.elastic_buffer.combine(
+            hidden_states.contiguous(),
+            handle,
+            # Router weights are already applied by SwiGLU.
+            topk_weights=None,
+        )
+        return combined_output[: combine_metadata.original_tokens].to(hidden_states.dtype)
