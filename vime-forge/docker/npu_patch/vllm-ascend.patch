+    manager.store_request_range([first.block_id], 0, rows(0, 4))
+    manager.store_request_range([shared.block_id], 0, rows(10, 14))
+    pool.free_blocks([first])
+    np.testing.assert_array_equal(manager.get([first.block_id], 4), rows(0, 4))
+    recycled = pool.get_new_blocks(1)[0]
+    assert recycled is first
+    with pytest.raises(RuntimeError, match="unwritten routed-experts"):
+        manager.get([recycled.block_id], 4, request_id="new")
+    # Old nonzero bytes remain, but they must no longer count as written.
+    assert np.any(manager.routed_experts_by_slot[first.block_id * 4 : (first.block_id + 1) * 4])
+    manager.store_request_range([recycled.block_id], 0, rows(20, 22))
+    np.testing.assert_array_equal(manager.get([recycled.block_id], 2), rows(20, 22))
+    with pytest.raises(RuntimeError, match="unwritten routed-experts"):
+        manager.get([recycled.block_id], 4)
+    np.testing.assert_array_equal(manager.get([shared.block_id], 4), rows(10, 14))
