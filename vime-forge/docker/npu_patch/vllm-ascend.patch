+    config = get_current_vllm_config()
+    model = config.model_config.hf_config
+    parallel = config.parallel_config
+    num_experts = getattr(model, "n_routed_experts", None) or getattr(model, "num_experts", None)
+    top_k = getattr(model, "num_experts_per_tok", None)
+    hidden_size = getattr(model, "hidden_size", None)
+    # MC2 groups are built in distributed.parallel_state from the DP, PCP and
+    # TP dimensions (the PP dimension forms the outer group list). Keep this
+    # calculation identical to the rank topology used for group creation.
+    ep_size = (
+        getattr(parallel, "data_parallel_size", 1)
+        * getattr(parallel, "prefill_context_parallel_size", 1)
+        * getattr(parallel, "tensor_parallel_size", 1)
+    )
+    if not all(x is not None for x in (num_experts, top_k, hidden_size, ep_size)):
+        return _DEFAULT_BUFFER_SIZE
+    if num_experts % ep_size:
+        raise ValueError("MC2 num_experts must be divisible by EP size")
+    experts_per_rank = num_experts // ep_size
+    mc2_tokens_capacity = calculate_mc2_tokens_capacity(config)
+    tokens_per_tp_rank = mc2_tokens_capacity // parallel.tensor_parallel_size
