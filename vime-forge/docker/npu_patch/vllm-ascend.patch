+            self.routed_experts_mgr.store_batch(routed.routing_data, routed.slot_mapping)
+            with pytest.raises(RuntimeError, match="scheduler range validation"):
+                self.routed_experts_mgr.store_batch(routed.routing_data, routed.slot_mapping)
