+def make_schedule_override_scheduler(manager, kv_manager, *, asynchronous=False):
+    class NativeBase:
+        def __init__(self, manager, kv_manager):
+            self.kv_cache_manager = kv_manager
+            self.routed_experts_mgr = manager
+            self.requests = {
+                "r": SimpleNamespace(num_preemptions=0, num_stale_output_tokens=0, is_finished=lambda: False)
+            }
+            self.num_sampled_tokens_per_step = 1
+
+        def schedule(self):
+            return self.build_output()
+
+        def build_output(self):
+            block = self.kv_cache_manager.block_pool.get_new_blocks(1)[0]
+            self.block = block
+            output = SimpleNamespace(num_scheduled_tokens={"r": 1}, scheduled_spec_decode_tokens={})
+            self._update_after_schedule(output)
+            return output
+
+        def _update_after_schedule(self, output):
+            output.scheduled_token_start = {"r": 0}
+            output.routed_experts_block_ids = {"r": [self.block.block_id]}
+
+        def _preempt_request(self, request, timestamp, drop_stale_output=False):
+            pass
+
+        def update_from_output(self, output, model_output):
+            return "updated"
+
+    class CustomScheduler(NativeBase):
+        def __init__(self, manager, kv_manager):
+            super().__init__(manager, kv_manager)
+
+        def schedule(self):
+            # The real Dyntra and Profiling classes reimplement schedule.
+            return self.build_output()
+
+    class CustomAsyncScheduler(CustomScheduler):
+        def _update_after_schedule(self, output):
+            super()._update_after_schedule(output)
+            output.async_hook_finished = True
+
+    capture_patch._patch_scheduler_routing_lifecycle(NativeBase)
+    capture_patch._patch_scheduler_routing_lifecycle(NativeBase)
+    cls = CustomAsyncScheduler if asynchronous else CustomScheduler
+    return cls(manager, kv_manager)
+
