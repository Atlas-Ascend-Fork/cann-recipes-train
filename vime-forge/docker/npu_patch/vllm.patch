+def _normalize_loaded_weight_dtype(
+    loaded_weight: torch.Tensor,
+    expected_dtype: torch.dtype,
+    tensor_name: str,
+) -> torch.Tensor:
+    """Safely normalize checkpoint tensors whose target is non-floating point.
+
+    Floating-point targets are left to their original weight loaders because
+    quantization loaders may intentionally accept a different floating dtype.
+    Integer and bool targets must preserve their numeric values during reload;
+    silently reinterpreting floating-point storage as integers can otherwise
+    produce valid-looking tensors with corrupted values.
+    """
+    if loaded_weight.dtype == expected_dtype or expected_dtype.is_floating_point:
+        return loaded_weight
+
+    if loaded_weight.is_complex():
+        raise TypeError(
+            f"Cannot reload {tensor_name}: complex source dtype "
+            f"{loaded_weight.dtype} is incompatible with {expected_dtype}"
+        )
+
+    if loaded_weight.is_floating_point():
+        if not bool(torch.isfinite(loaded_weight).all().item()):
+            raise ValueError(
+                f"Cannot reload {tensor_name}: non-finite values cannot be "
+                f"converted from {loaded_weight.dtype} to {expected_dtype}"
+            )
+        if not bool((loaded_weight == torch.trunc(loaded_weight)).all().item()):
+            raise ValueError(
+                f"Cannot reload {tensor_name}: non-integral values cannot be "
+                f"converted from {loaded_weight.dtype} to {expected_dtype}"
+            )
+
+    if loaded_weight.numel() > 0:
+        min_value = loaded_weight.min().item()
+        max_value = loaded_weight.max().item()
+        if expected_dtype == torch.bool:
+            lower, upper = 0, 1
+        else:
+            dtype_info = torch.iinfo(expected_dtype)
+            lower, upper = dtype_info.min, dtype_info.max
+        if min_value < lower or max_value > upper:
+            raise ValueError(
+                f"Cannot reload {tensor_name}: value range [{min_value}, "
+                f"{max_value}] does not fit {expected_dtype} range "
+                f"[{lower}, {upper}]"
+            )
+
+    return loaded_weight.to(dtype=expected_dtype)
+
+
