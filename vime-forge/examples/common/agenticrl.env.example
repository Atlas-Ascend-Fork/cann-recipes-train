#!/usr/bin/env bash
# 复制为仓库外的 agenticrl.local.sh，通过任务入口的 --local 加载。
# 这是 Bash 配置文件；不激活环境、不启动进程，也无需再加载另一份 env。
# 新部署可使用同目录的 agenticrl.local.sh.example；两份模板选用一份即可。

# 机器安装位置：与单轮 RL 共用；解释器、Ray 和 vLLM 路径由环境目录推导。
export VIME_TRAIN_ENV=/path/to/envs/train
export VIME_VLLM_ENV=/path/to/envs/rollout
# 可选覆盖，应属于对应的环境；Ray 和推理 Python 仍由环境目录推导。
# export TRAIN_PYTHON="$VIME_TRAIN_ENV/bin/python3"
# export VIME_VLLM_EXECUTABLE="$VIME_VLLM_ENV/bin/vllm"
export VIME_CANN_HOME=/path/to/cann
export VIME_NNAL_HOME=/path/to/atb
export MODEL_PATH=/path/to/models/Qwen3.5-4B
export ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
export MASTER_ADDR=192.0.2.1 # 替换为训练机可达地址

# 沙箱部署：主机、容量和准备并发放在 JSON 中，不在这里重复填写。
export VIME_AGENT_SANDBOX_BACKEND=harbor
export VIME_AGENT_SANDBOX_CONFIG="$HOME/.config/vime/sandboxes.json"

# 模型回调和安装包：按沙箱实际可达的网络及安装位置填写。
export ADAPTER_PUBLIC_HOST=model-callback.example
export VIME_AGENT_NODE_TARBALL=/path/to/artifacts/node.tar.xz
export VIME_AGENT_CODEX_TARBALL=/path/to/artifacts/codex.tgz
# SWE 评测依赖；Terminal 不需要。
export VIME_SWEGYM_SOURCE_PATH=/path/to/SWE-Gym-evaluator
# 仅在当前部署需要时覆盖。以下参数按部署需要填写。
# 回调默认监听 0.0.0.0:18001，沙箱访问端口默认 18080；隧道部署可覆盖监听地址。
# export ADAPTER_BIND_HOST=127.0.0.1
# export ADAPTER_PORT=18001 ADAPTER_PUBLIC_PORT=18080
# export VIME_AGENT_ARTIFACT_BASE_URL=http://artifacts.example:18123
# AgenticRL 默认训练 TP=4、DP=1、CP=1，推理使用四个 TP=1 引擎。
# export TRAIN_TP=4 TRAIN_DP=1 TRAIN_CP=1 ROLLOUT_GPUS=4 VLLM_RANKS_PER_ENGINE=1
# Qwen3.5 开启 CP=4：四张训练设备，推理配置保持原值。
# export TRAIN_TP=1 TRAIN_DP=1 TRAIN_CP=4
# 省略 TITAN_CONFIG 时按 CP 自动选择 recipe；KL-Cov 使用 CP=1。
# 详细说明见 docs/rl/qwen35.md。
# 库版本由已安装的软件包识别，无需在启动配置中重复指定。
# 最小配置不包含手工 Python 库路径或 CC 包装；依赖兼容问题在环境准备时解决。
# ATB 等机器覆盖应按最终工作进程配置验证，不照搬其他服务器。
# 不在此重设整个 PATH；Python/CANN/ATB 激活由 Qwen3.5 入口完成。
# 缓存由 VIME_WORKSPACE 派生，TMPDIR 沿用外部环境；Ray 服务端口由 VIME_SLOT 派生。
# 特殊的短路径、端口隔离、代理及资源限制可按需覆盖，详见 README。

# 实验参数：使用原生训练参数；也可直接放在启动命令的 -- 后。
OVERRIDE_ARGS=(--rollout-batch-size 32 --n-samples-per-prompt 8
               --router-policy consistent_hash --vllm-server-concurrency 8)
