+    cmd+=(--opts "train.max_train_steps=${max_train_steps}")
+fi
+if [[ -n "${num_train_epochs}" ]]; then
+    cmd+=(--opts "train.num_train_epochs=${num_train_epochs}")
+fi
+if [[ -n "${exp_name}" ]]; then
+    cmd+=(--opts "exp_name=${exp_name}")
+fi
+if [[ -n "${n_routed_experts}" ]]; then
+    cmd+=(--opts "model.n_routed_experts=${n_routed_experts}")
+fi
+if [[ -n "${tau_loss_alpha}" ]]; then
+    cmd+=(--opts "model.tau_loss_alpha=${tau_loss_alpha}")
+fi
+if [[ -n "${sharding_strategy}" ]]; then
+    cmd+=(--opts "train.sharding_strategy=${sharding_strategy}")
+fi
+
