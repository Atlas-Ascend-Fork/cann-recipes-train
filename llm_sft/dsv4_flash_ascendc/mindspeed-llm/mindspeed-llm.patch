+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+REPO_ROOT=$(cd "${SCRIPT_DIR}/../../.." && pwd)
+VERIFY_SCRIPT="${REPO_ROOT}/mindspeed_llm/tasks/preprocess/verify_deepseek4_data.py"
+PREPARE_SCRIPT="${REPO_ROOT}/mindspeed_llm/tasks/preprocess/prepare_deepseek4_data.py"
+
+JSONL_INPUTS=()
+TOKENIZER_PATH=""
+DATA_OUTPUT_DIR=""
+SEQ_LEN=32768
+
+# skip: keep every row unchanged and exclude the complete row when its
+#       prompt + answer token count is >= SEQ_LEN.
+# error: stop if any row would be truncated by preprocessing.
+OVERLENGTH_POLICY="skip"
+PREPROCESS_WORKERS=8
+PYTHON_BIN="${PYTHON_BIN:-python}"
+
+usage() {
+    cat <<'EOF'
+Usage:
+  bash examples/mcore/deepseek4_flash/prepare_data.sh \
+    --input INPUT_JSONL [--input INPUT_JSONL ...] \
+    --tokenizer-name-or-path TOKENIZER_PATH \
+    --output-dir DATA_OUTPUT_DIR [options]
+
+Options:
+  --seq-length N             preprocessing and training sequence length (default: 32768)
+  --overlength-policy VALUE  skip (default) or error
+  --workers N                preprocessing workers (default: 8)
+
+Each JSONL row must contain instruction, input and output string fields.
+Multiple inputs are concatenated in the order given.
+
+The script never truncates a row in place. With policy=skip, an over-length
+row is omitted as a whole and the original JSON text remains unchanged.
+Use the printed DATA_PATH for training, and keep the training sequence length
+equal to --seq-length. Use a matching output directory when changing this value.
+EOF
+}
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --input|--tokenizer-name-or-path|--output-dir|--seq-length|--overlength-policy|--workers)
+            [[ $# -ge 2 ]] || { echo "ERROR: $1 needs a value" >&2; exit 2; }
+            case "$1" in
+                --input) JSONL_INPUTS+=("$2") ;;
+                --tokenizer-name-or-path) TOKENIZER_PATH=$2 ;;
+                --output-dir) DATA_OUTPUT_DIR=$2 ;;
+                --seq-length) SEQ_LEN=$2 ;;
+                --overlength-policy) OVERLENGTH_POLICY=$2 ;;
+                --workers) PREPROCESS_WORKERS=$2 ;;
+            esac
+            shift 2
+            ;;
+        -h|--help)
+            usage
+            exit 0
+            ;;
+        *)
+            usage >&2
+            echo "ERROR: unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ "${#JSONL_INPUTS[@]}" -eq 0 || -z "${TOKENIZER_PATH}" || -z "${DATA_OUTPUT_DIR}" ]]; then
+    usage >&2
+    exit 2
+fi
+
+[[ "${SEQ_LEN}" =~ ^[1-9][0-9]*$ ]] || {
+    echo "ERROR: SEQ_LEN must be a positive integer: ${SEQ_LEN}" >&2
+    exit 2
+}
+[[ "${OVERLENGTH_POLICY}" == "skip" || "${OVERLENGTH_POLICY}" == "error" ]] || {
+    echo "ERROR: OVERLENGTH_POLICY must be skip or error: ${OVERLENGTH_POLICY}" >&2
+    exit 2
+}
+[[ "${PREPROCESS_WORKERS}" =~ ^[1-9][0-9]*$ ]] || {
+    echo "ERROR: PREPROCESS_WORKERS must be a positive integer: ${PREPROCESS_WORKERS}" >&2
+    exit 2
+}
+TOKENIZER_PATH=$(realpath -m "${TOKENIZER_PATH}")
+DATA_OUTPUT_DIR=$(realpath -m "${DATA_OUTPUT_DIR}")
+DATA_PARENT_DIR=$(dirname "${DATA_OUTPUT_DIR}")
+[[ "${DATA_OUTPUT_DIR}" != "/" && "${DATA_PARENT_DIR}" != "/" ]] || {
+    echo "ERROR: DATA_OUTPUT_DIR is too broad: ${DATA_OUTPUT_DIR}" >&2
+    exit 2
+}
+MERGED_JSONL_PATH="${DATA_OUTPUT_DIR}.merged.jsonl"
+FILTERED_JSONL_PATH="${DATA_OUTPUT_DIR}.seq${SEQ_LEN}.filtered.jsonl"
+DATA_PATH="${DATA_OUTPUT_DIR}/alpaca"
+PACKED_DATA_PATH="${DATA_PATH}_packed"
+
+for index in "${!JSONL_INPUTS[@]}"; do
+    JSONL_INPUTS[$index]=$(realpath -m "${JSONL_INPUTS[$index]}")
+    [[ -f "${JSONL_INPUTS[$index]}" ]] || {
+        echo "ERROR: input JSONL not found: ${JSONL_INPUTS[$index]}" >&2
+        exit 1
+    }
+done
+for input_path in "${JSONL_INPUTS[@]}"; do
+    if [[ "${input_path}" == "${DATA_OUTPUT_DIR}" || "${input_path}" == "${DATA_OUTPUT_DIR}"/* ]]; then
+        echo "ERROR: an input JSONL must not be inside DATA_OUTPUT_DIR: ${input_path}" >&2
+        exit 2
+    fi
+done
+if [[ "${REPO_ROOT}" == "${DATA_OUTPUT_DIR}" || "${REPO_ROOT}" == "${DATA_OUTPUT_DIR}"/* ||
+      "${TOKENIZER_PATH}" == "${DATA_OUTPUT_DIR}" || "${TOKENIZER_PATH}" == "${DATA_OUTPUT_DIR}"/* ]]; then
+    echo "ERROR: DATA_OUTPUT_DIR must not contain the repository or tokenizer: ${DATA_OUTPUT_DIR}" >&2
+    exit 2
+fi
+if [[ -e "${DATA_OUTPUT_DIR}" && ! -d "${DATA_OUTPUT_DIR}" ]]; then
+    echo "ERROR: DATA_OUTPUT_DIR exists but is not a directory: ${DATA_OUTPUT_DIR}" >&2
+    exit 2
+fi
+[[ -f "${TOKENIZER_PATH}/tokenizer.json" ]] || {
+    echo "ERROR: tokenizer.json not found under: ${TOKENIZER_PATH}" >&2
+    exit 1
+}
+
+mkdir -p "${DATA_PARENT_DIR}"
+export PYTHONPATH="${REPO_ROOT}/3rdparty/MindSpeed:${REPO_ROOT}/3rdparty/Megatron-LM:${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
+
+echo "Data preparation: inputs=${#JSONL_INPUTS[@]}, seq_length=${SEQ_LEN}, overlength=${OVERLENGTH_POLICY}"
+echo "Output directory: ${DATA_OUTPUT_DIR}"
+
+merge_jsonl_inputs() {
+    "${PYTHON_BIN}" "${PREPARE_SCRIPT}" merge "${MERGED_JSONL_PATH}" "${JSONL_INPUTS[@]}"
+}
+
+if [[ "${#JSONL_INPUTS[@]}" -eq 1 ]]; then
+    PREPROCESS_INPUT_PATH="${JSONL_INPUTS[0]}"
+    echo "Using one input JSONL directly: ${PREPROCESS_INPUT_PATH}"
+else
+    merge_jsonl_inputs
+    PREPROCESS_INPUT_PATH="${MERGED_JSONL_PATH}"
+fi
+
+PREPROCESS_INPUT_SHA256=$(sha256sum "${PREPROCESS_INPUT_PATH}" | awk '{print $1}')
+EXPECTED_SAMPLES=$(awk 'END { print NR + 0 }' "${PREPROCESS_INPUT_PATH}")
+[[ "${EXPECTED_SAMPLES}" -gt 0 ]] || {
+    echo "ERROR: input JSONL has no rows: ${PREPROCESS_INPUT_PATH}" >&2
+    exit 1
+}
+
+preflight_args=(
+    --raw-data "${PREPROCESS_INPUT_PATH}"
+    --expected-raw-sha256 "${PREPROCESS_INPUT_SHA256}"
+    --expected-samples "${EXPECTED_SAMPLES}"
+    --tokenizer-path "${TOKENIZER_PATH}"
+    --seq-length "${SEQ_LEN}"
+    --preflight-only
+)
+if [[ "${OVERLENGTH_POLICY}" == "skip" ]]; then
+    preflight_args+=(--filter-overlength-to "${FILTERED_JSONL_PATH}")
+fi
+"${PYTHON_BIN}" "${VERIFY_SCRIPT}" "${preflight_args[@]}"
+
+if [[ "${OVERLENGTH_POLICY}" == "skip" ]]; then
+    PREPROCESS_INPUT_PATH="${FILTERED_JSONL_PATH}"
+    PREPROCESS_INPUT_SHA256=$(sha256sum "${PREPROCESS_INPUT_PATH}" | awk '{print $1}')
+    EXPECTED_SAMPLES=$(awk 'END { print NR + 0 }' "${PREPROCESS_INPUT_PATH}")
+    [[ "${EXPECTED_SAMPLES}" -gt 0 ]] || {
+        echo "ERROR: all rows exceed SEQ_LEN=${SEQ_LEN}" >&2
+        exit 1
+    }
+fi
+
+dataset_files=()
+for key in input_ids attention_mask labels; do
+    dataset_files+=("${PACKED_DATA_PATH}_${key}_document.bin" "${PACKED_DATA_PATH}_${key}_document.idx")
+done
+
+ready_files=0
+for path in "${dataset_files[@]}"; do
+    [[ -s "${path}" ]] && ready_files=$((ready_files + 1))
+done
+
+annotate_manifest() {
+    local manifest_path=$1
+    "${PYTHON_BIN}" "${PREPARE_SCRIPT}" annotate "${manifest_path}" "${OVERLENGTH_POLICY}" "${JSONL_INPUTS[@]}"
+}
+
+print_summary() {
+    "${PYTHON_BIN}" "${PREPARE_SCRIPT}" summary "${DATA_OUTPUT_DIR}/dataset_manifest.json" "${DATA_PATH}"
+}
+
+if [[ "${ready_files}" -eq "${#dataset_files[@]}" && -s "${DATA_OUTPUT_DIR}/dataset_manifest.json" ]]; then
+    if "${PYTHON_BIN}" "${VERIFY_SCRIPT}" \
+        --raw-data "${PREPROCESS_INPUT_PATH}" \
+        --expected-raw-sha256 "${PREPROCESS_INPUT_SHA256}" \
+        --expected-samples "${EXPECTED_SAMPLES}" \
+        --tokenizer-path "${TOKENIZER_PATH}" \
+        --data-prefix "${PACKED_DATA_PATH}" \
+        --seq-length "${SEQ_LEN}" \
+        --manifest "${DATA_OUTPUT_DIR}/dataset_manifest.json"; then
+        annotate_manifest "${DATA_OUTPUT_DIR}/dataset_manifest.json"
+        print_summary
+        echo "Existing indexed dataset passed validation; nothing was rebuilt."
+        exit 0
+    fi
+    echo "Existing dataset does not match the current inputs; rebuilding safely."
+fi
+
+stage_dir=$(mktemp -d "${DATA_OUTPUT_DIR}.tmp.XXXXXX")
+cleanup_stage() {
+    if [[ -n "${stage_dir:-}" && -d "${stage_dir}" && "${stage_dir}" == "${DATA_OUTPUT_DIR}.tmp."* ]]; then
+        rm -rf -- "${stage_dir}"
+    fi
+}
+trap cleanup_stage EXIT
+
+cd "${REPO_ROOT}"
+"${PYTHON_BIN}" ./preprocess_data.py \
+    --input "${PREPROCESS_INPUT_PATH}" \
+    --tokenizer-name-or-path "${TOKENIZER_PATH}" \
+    --output-prefix "${stage_dir}/alpaca" \
+    --handler-name AlpacaStyleInstructionHandler \
+    --tokenizer-type PretrainedFromHF \
+    --seq-length "${SEQ_LEN}" \
+    --workers "${PREPROCESS_WORKERS}" \
+    --log-interval 100 \
+    --prompt-type deepseek4 \
+    --enable-thinking false
+
+stage_prefix="${stage_dir}/alpaca_packed"
+"${PYTHON_BIN}" "${VERIFY_SCRIPT}" \
+    --raw-data "${PREPROCESS_INPUT_PATH}" \
+    --expected-raw-sha256 "${PREPROCESS_INPUT_SHA256}" \
+    --expected-samples "${EXPECTED_SAMPLES}" \
+    --tokenizer-path "${TOKENIZER_PATH}" \
+    --data-prefix "${stage_prefix}" \
+    --seq-length "${SEQ_LEN}" \
+    --manifest "${stage_dir}/dataset_manifest.json"
+annotate_manifest "${stage_dir}/dataset_manifest.json"
+
+backup_dir=""
+if [[ -d "${DATA_OUTPUT_DIR}" ]]; then
+    backup_dir="${DATA_OUTPUT_DIR}.backup.$(date +%Y%m%d_%H%M%S).$$"
+    mv -- "${DATA_OUTPUT_DIR}" "${backup_dir}"
+fi
+if ! mv -- "${stage_dir}" "${DATA_OUTPUT_DIR}"; then
+    if [[ -n "${backup_dir}" && -d "${backup_dir}" && ! -e "${DATA_OUTPUT_DIR}" ]]; then
+        mv -- "${backup_dir}" "${DATA_OUTPUT_DIR}"
+    fi
+    echo "ERROR: failed to install generated dataset" >&2
+    exit 1
+fi
+stage_dir=""
+
+print_summary
+if [[ -n "${backup_dir}" ]]; then
+    echo "Previous dataset backup: ${backup_dir}"
+fi
