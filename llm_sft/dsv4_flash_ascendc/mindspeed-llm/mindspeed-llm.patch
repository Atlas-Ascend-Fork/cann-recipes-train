+#!/bin/bash
+set -euo pipefail
+
+# dSPARK is the attached speculative-decoding module; this script converts the
+# 43-layer target-model backbone used by the LoRA training configuration.
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+REPO_ROOT=$(cd "${SCRIPT_DIR}/../../.." && pwd)
+
+if [[ $# -ne 2 ]]; then
+    echo "Usage: bash $0 <DeepSeek-V4-Flash-0731-BF16-HF-dir> <output-MCore-dir>" >&2
+    exit 2
+fi
+
+INPUT_BF16_DIR=$(realpath "$1")
+OUTPUT_MCORE_DIR=$(realpath -m "$2")
+
+TARGET_TP=${TARGET_TP:-1}
+TARGET_PP=${TARGET_PP:-2}
+TARGET_EP=${TARGET_EP:-16}
+
+if [[ -n "${CANN_ENV_SCRIPT:-}" ]]; then
+    # shellcheck disable=SC1090
+    source "${CANN_ENV_SCRIPT}"
+elif [[ -f /usr/local/Ascend/cann/set_env.sh ]]; then
+    # shellcheck disable=SC1091
+    source /usr/local/Ascend/cann/set_env.sh
+elif [[ -f /usr/local/Ascend/ascend-toolkit/set_env.sh ]]; then
+    # shellcheck disable=SC1091
+    source /usr/local/Ascend/ascend-toolkit/set_env.sh
+elif [[ -z "${ASCEND_HOME_PATH:-}" ]]; then
+    echo "CANN environment is not loaded. Set CANN_ENV_SCRIPT to the correct set_env.sh." >&2
+    exit 1
+fi
+
+export PYTHONPATH="${REPO_ROOT}/3rdparty/MindSpeed:${REPO_ROOT}/3rdparty/Megatron-LM:${PYTHONPATH:-}"
+
+cd "${REPO_ROOT}"
+python convert_ckpt_v2.py \
+    --load-model-type hf \
+    --save-model-type mg \
+    --model-type-hf deepseek4 \
+    --load-dir "${INPUT_BF16_DIR}" \
+    --save-dir "${OUTPUT_MCORE_DIR}" \
+    --target-tensor-parallel-size "${TARGET_TP}" \
+    --target-pipeline-parallel-size "${TARGET_PP}" \
+    --target-expert-parallel-size "${TARGET_EP}" \
+    --expert-tensor-parallel-size 1 \
+    --noop-layers 43 \
+    --mtp-num-layers 0 \
+    --deepseek4-backbone-only \
+    --validate-flash-0731 \
+    --moe-grouped-gemm
