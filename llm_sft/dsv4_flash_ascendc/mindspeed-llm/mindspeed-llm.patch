+++ b/mindspeed_llm/tasks/preprocess/prepare_deepseek4_data.py
@@ -0,0 +1,133 @@
+"""Merge DeepSeek-V4 JSONL inputs and record prepared dataset metadata."""
+
+import argparse
+import hashlib
+import json
+import os
+import tempfile
+from pathlib import Path
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def merge_jsonl_inputs(output, sources):
+    output = output.resolve()
+    sources = [source.resolve() for source in sources]
+    if len(set(sources)) != len(sources):
+        raise SystemExit("Input JSONL paths must be unique")
+    if output in sources:
+        raise SystemExit("Merged output must not also be an input")
+
+    fd, temporary_name = tempfile.mkstemp(prefix=f".{output.name}.", suffix=".tmp", dir=output.parent)
+    temporary = Path(temporary_name)
+    counts = []
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as destination:
+            for source in sources:
+                count = 0
+                with source.open("r", encoding="utf-8") as stream:
+                    for line_number, line in enumerate(stream, start=1):
+                        text = line.rstrip("\r\n")
+                        if not text:
+                            raise ValueError(f"{source}:{line_number}: empty line")
+                        try:
+                            row = json.loads(text)
+                        except json.JSONDecodeError as error:
+                            raise ValueError(f"{source}:{line_number}: invalid JSON: {error}") from error
+                        if not isinstance(row, dict) or set(row) != {"instruction", "input", "output"}:
+                            raise ValueError(f"{source}:{line_number}: expected instruction/input/output fields")
+                        if not all(isinstance(row[key], str) for key in row):
+                            raise ValueError(f"{source}:{line_number}: all fields must be strings")
+                        if not row["input"] or not row["output"]:
+                            raise ValueError(f"{source}:{line_number}: input/output must be non-empty")
+                        destination.write(text + "\n")
+                        count += 1
+                if count == 0:
+                    raise ValueError(f"Input JSONL has no rows: {source}")
+                counts.append(count)
+            destination.flush()
+            os.fsync(destination.fileno())
+
+        digest = sha256_file(temporary)
+        if output.is_file() and sha256_file(output) == digest:
+            action = "Reused"
+        else:
+            os.replace(temporary, output)
+            action = "Wrote"
+        for source, count in zip(sources, counts):
+            print(f"Input JSONL: rows={count}, path={source}")
+        print(f"{action} merged JSONL: rows={sum(counts)}, sha256={digest}, path={output}")
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def describe(path):
+    digest = hashlib.sha256()
+    rows = 0
+    with path.open("rb") as stream:
+        for line in stream:
+            digest.update(line)
+            rows += 1
+    return {"path": str(path), "rows": rows, "sha256": digest.hexdigest()}
+
+
+def annotate_manifest(manifest_path, overlength_policy, sources):
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    manifest["overlength_policy"] = overlength_policy
+    manifest["source_jsonl"] = [describe(source.resolve()) for source in sources]
+    manifest_path.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+def print_summary(manifest_path, data_path):
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    documents = manifest["documents"]
+    tokens = manifest["tokens"]
+    print("Dataset ready:")
+    print(f"  documents           : {documents}")
+    print(f"  seq length          : {manifest['seq_length']}")
+    print(f"  tokens min/avg/max  : {tokens['minimum']}/{tokens['total'] / documents:.1f}/{tokens['maximum']}")
+    print(f"  assistant tokens    : {tokens['assistant_total']}")
+    print(f"  data path for train : {data_path}")
+    print(f"  manifest            : {manifest_path}")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+
+    merge = commands.add_parser("merge", help="Concatenate JSONL inputs in order.")
+    merge.add_argument("output", type=Path)
+    merge.add_argument("inputs", type=Path, nargs="+")
+
+    annotate = commands.add_parser("annotate", help="Record input files and the overlength policy.")
+    annotate.add_argument("manifest", type=Path)
+    annotate.add_argument("overlength_policy")
+    annotate.add_argument("inputs", type=Path, nargs="+")
+
+    count = commands.add_parser("count", help="Print the dataset document count.")
+    count.add_argument("manifest", type=Path)
+
+    summary = commands.add_parser("summary", help="Print prepared dataset statistics.")
+    summary.add_argument("manifest", type=Path)
+    summary.add_argument("data_path")
+
+    args = parser.parse_args()
+    if args.command == "merge":
+        merge_jsonl_inputs(args.output, args.inputs)
+    elif args.command == "annotate":
+        annotate_manifest(args.manifest, args.overlength_policy, args.inputs)
+    elif args.command == "count":
+        with args.manifest.open(encoding="utf-8") as stream:
+            print(json.load(stream)["documents"])
+    else:
+        print_summary(args.manifest, args.data_path)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/mindspeed_llm/tasks/preprocess/verify_deepseek4_data.py b/mindspeed_llm/tasks/preprocess/verify_deepseek4_data.py
