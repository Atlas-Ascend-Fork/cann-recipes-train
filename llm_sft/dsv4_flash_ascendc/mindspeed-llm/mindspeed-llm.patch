+#!/usr/bin/env bash
+set -euo pipefail
+
+# DeepSeek-V4-Flash-0731 LoRA-only MCore checkpoint -> merged BF16 HF backbone.
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+REPO_ROOT=$(cd "${SCRIPT_DIR}/../../.." && pwd)
+
+# Use the exact training base and BF16 HF metadata. Choose a new or empty output directory.
+CANN_ENV_SCRIPT="${CANN_ENV_SCRIPT:-/usr/local/Ascend/cann/set_env.sh}"
+BASE_MCORE="${BASE_MCORE:-/data/models/DeepSeek-V4-Flash-0731-mcore}"
+LORA_MCORE="${LORA_MCORE:-/data/checkpoints/dsv4_flash_0731_nothink_64k_complete}"
+HF_META="${HF_META:-/data/models/DeepSeek-V4-Flash-0731-BF16}"
+OUT_HF="${OUT_HF:-/data/models/DeepSeek-V4-Flash-0731-lora-hf}"
+
+# Match the LoRA rank, alpha, and target modules used for training.
+LORA_R="${LORA_R:-32}"
+LORA_ALPHA="${LORA_ALPHA:-64}"
+LORA_TARGET_MODULES=(
+    linear_q
+    linear_kv
+    linear_fc1
+    linear_fc2
+    linear_q_up_proj
+    linear_o_down_proj
+    linear_o_up_proj
+)
+
+# The converter uses one NPU for the FP32 LoRA matrix multiplications.
+CONVERT_DEVICE="${CONVERT_DEVICE:-0}"
+PYTHON_BIN="${PYTHON_BIN:-python}"
+
+# CANN's set_env.sh may inspect unset shell variables, so source it without nounset.
+set +u
+# shellcheck disable=SC1090
+source "${CANN_ENV_SCRIPT}"
+set -u
+
+export PYTHONPATH="${REPO_ROOT}/3rdparty/MindSpeed:${REPO_ROOT}/3rdparty/Megatron-LM:${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
+export ASCEND_RT_VISIBLE_DEVICES="${CONVERT_DEVICE}"
+export CUDA_DEVICE_MAX_CONNECTIONS=1
+export PYTORCH_NPU_ALLOC_CONF="${PYTORCH_NPU_ALLOC_CONF:-expandable_segments:True}"
+
+cd "${REPO_ROOT}"
+
+"${PYTHON_BIN}" convert_ckpt_v2.py \
+    --load-model-type mg \
+    --save-model-type hf \
+    --model-type-hf deepseek4 \
+    --load-dir "${BASE_MCORE}" \
+    --lora-load "${LORA_MCORE}" \
+    --save-dir "${OUT_HF}" \
+    --hf-cfg-dir "${HF_META}" \
+    --noop-layers 43 \
+    --mtp-num-layers 0 \
+    --deepseek4-backbone-only \
+    --validate-flash-0731 \
+    --moe-grouped-gemm \
+    --expert-tensor-parallel-size 1 \
+    --lora-r "${LORA_R}" \
+    --lora-alpha "${LORA_ALPHA}" \
+    --lora-target-modules "${LORA_TARGET_MODULES[@]}"
