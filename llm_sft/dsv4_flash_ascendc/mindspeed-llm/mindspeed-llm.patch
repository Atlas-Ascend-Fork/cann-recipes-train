@@ -0,0 +1,280 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Standalone Flash-0731 no-think LoRA training: two A3 nodes, 16 dies per node.
+# Run in the MindSpeed-LLM training environment on both nodes:
+# MASTER_ADDR=<node-0-IP> NODE_RANK=0 bash this_script.sh <TP1-PP2-EP16-BF16-MCore-dir>
+# Use NODE_RANK=1 on node 1. Dataset/checkpoint paths must be accessible on both.
+# To resume, set RESUME_DIR to the saved LoRA checkpoint root; keep the same backbone argument.
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+REPO_ROOT=$(cd "${SCRIPT_DIR}/../../.." && pwd)
+PYTHON_BIN="${PYTHON_BIN:-python}"
+CKPT_LOAD_DIR="${1:?Pass the TP1-PP2-EP16 BF16 backbone MCore checkpoint directory}"
+RESUME_DIR="${RESUME_DIR:-}"
+
+# Distributed configuration.
+NPUS_PER_NODE=16
+NNODES=2
+: "${MASTER_ADDR:?Set MASTER_ADDR to the training IP of node 0}"
+: "${NODE_RANK:?Set NODE_RANK to 0 or 1 on the corresponding node}"
+MASTER_PORT="${MASTER_PORT:-6000}"
+
+# Checkpoint, data and log paths.
+TOKENIZER_PATH="${TOKENIZER_PATH:-/data/models/deepseek_v4_int8_w8a8}"
+DATA_OUTPUT_DIR="${DATA_OUTPUT_DIR:-/data/datasets/dsv4_flash_0731_nothink_64k}"
+DATA_PATH="${DATA_OUTPUT_DIR}/alpaca"
+CKPT_SAVE_DIR="${CKPT_SAVE_DIR:-${RESUME_DIR:-/data/checkpoints/dsv4_flash_0731_nothink_64k}}"
+LOG_DIR="${LOG_DIR:-${REPO_ROOT}/logs/deepseek4_flash_0731_nothink_64k}"
+LOG_FILE="${LOG_DIR}/train_node${NODE_RANK}_$(date +%Y%m%d_%H%M%S).log"
+
+# Model parallelism and batch sizes.
+TP=1
+PP=2
+EP=16
+CP=16
+CP_TYPE=kvallgather_cp_algo
+NUM_LAYERS=44
+SEQ_LEN=65536
+MBS=1
+GBS="${GBS:-8}"
+
+# Training hyperparameters.
+TRAIN_EPOCHS=5
+LR="${LR:-1e-5}"
+MIN_LR="${MIN_LR:-1e-7}"
+WEIGHT_DECAY=0.0
+CLIP_GRAD=1.0
+SEED=42
+DATALOADER_WORKERS=8
+
+LORA_R=32
+LORA_ALPHA=64
+
+# The preparation script records the sample count after whole-row length filtering.
+EXPECTED_SAMPLES=$("${PYTHON_BIN}" "${REPO_ROOT}/mindspeed_llm/tasks/preprocess/prepare_deepseek4_data.py" \
+    count "${DATA_OUTPUT_DIR}/dataset_manifest.json")
+STEPS_PER_EPOCH=$(((EXPECTED_SAMPLES + GBS - 1) / GBS))
+TRAIN_ITERS="${TRAIN_ITERS:-$((STEPS_PER_EPOCH * TRAIN_EPOCHS))}"
+SAVE_INTERVAL="${SAVE_INTERVAL:-${STEPS_PER_EPOCH}}"
+WARMUP_ITERS=$((TRAIN_ITERS / 10))
+
+# Runtime environment. Keep CANN setup before the training-specific exports.
+if [[ -n "${CANN_ENV_SCRIPT:-}" ]]; then
+    set +u
+    source "${CANN_ENV_SCRIPT}"
+    set -u
+fi
+export PYTHONPATH="${REPO_ROOT}/3rdparty/MindSpeed:${REPO_ROOT}/3rdparty/Megatron-LM:${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
+export HCCL_CONNECT_TIMEOUT=7200
+export HCCL_EXEC_TIMEOUT=7200
+export ACL_DEVICE_SYNC_TIMEOUT=7200
+export CUDA_DEVICE_MAX_CONNECTIONS=1
+export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
+export TASK_QUEUE_ENABLE=1
+export CPU_AFFINITY_CONF=1
+export HCCL_ALGO="alltoall=level0:NA;level1:pipeline"
+mkdir -p "${CKPT_SAVE_DIR}" "${LOG_DIR}"
+cd "${REPO_ROOT}"
+
+DISTRIBUTED_ARGS=(
+    --nproc_per_node "${NPUS_PER_NODE}"
+    --nnodes "${NNODES}"
+    --node_rank "${NODE_RANK}"
+    --master_addr "${MASTER_ADDR}"
+    --master_port "${MASTER_PORT}"
+)
+
+DSA_ARGS=(
+    --enable-dsa-indexer
+    --index-n-heads 64
+    --index-head-dim 128
+    --index-topk 512
+    --enable-mhc
+    --use-fused-mhc
+    --hc-mult 4
+    --kv-compress
+    --use-fused-lightning-indexer-loss
+    --use-fused-lightning-indexer
+    --use-sparse-flash-attn
+    # Preserve the original indexer-loss setting and fused attention path.
+    --indexer-loss-coeff 1.0
+)
+
+MLA_ARGS=(
+    --multi-latent-attention
+    --qk-pos-emb-head-dim 64
+    --qk-head-dim 512
+    --q-lora-rank 1024
+    --o-lora-rank 1024
+    --kv-lora-rank 512
+    --v-head-dim 128
+    --qk-layernorm
+    --mla-fa-without-pad
+)
+
+CA_ARGS=(
+    --o-groups 8
+    --sliding-window-size 128
+    --original-seq-len 65536
+    --rope-factor 16
+    --compress-rope-theta 160000.0
+    --max-batch-size 4
+    --compress-ratios 0 0 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4 128 4
+)
+
+MOE_ARGS=(
+    --moe-grouped-gemm
+    --moe-permutation-async-comm
+    # 仓内 MoE LoRA 要求 alltoall_seq；此限制本身不要求固定序列长度。
+    --moe-token-dispatcher-type alltoall_seq
+    --moe-layer-freq 1
+    --first-k-dense-replace -1
+    --num-experts 256
+    --moe-router-topk 6
+    --moe-ffn-hidden-size 2048
+    --moe-router-load-balancing-type none
+    --moe-router-group-topk 1
+    --moe-router-num-groups 1
+    --moe-router-topk-scaling-factor 1.5
+    # Fixed 64K padding must not contribute an auxiliary routing objective.
+    --moe-aux-loss-coeff 0.0
+    --moe-router-score-function sqrtsoftplus
+    --moe-router-enable-expert-bias
+    # Use the pretrained bias without changing it during LoRA SFT.
+    --moe-router-bias-update-rate 0.0
+    --moe-shared-expert-intermediate-size 2048
+    --moe-router-dtype fp32
+    --n-hash-layers 3
+    --moe-permute-fusion
+)
+
+MEM_ARGS=(
+    --recompute-granularity full
+    --recompute-method uniform
+    --recompute-num-layers 1
+    --swap-optimizer
+)
+
+ROPE_ARGS=(
+    --beta-fast 32
+    --beta-slow 1
+    --rope-scaling-factor 40
+    --rope-scaling-mscale 1.0
+    --rope-scaling-mscale-all-dim 1.0
+    --rope-scaling-original-max-position-embeddings "${SEQ_LEN}"
+    --rope-scaling-type yarn
+)
+
+GPT_ARGS=(
+    --noop-layers 43
+    --transformer-impl local
+    --spec mindspeed_llm.tasks.models.spec.deepseek4_spec layer_spec
+    --manual-gc
+    --manual-gc-interval 50
+    --empty-unused-memory-level 1
+    --use-distributed-optimizer
+    --use-flash-attn
+    --use-mcore-models
+    --tensor-model-parallel-size "${TP}"
+    --pipeline-model-parallel-size "${PP}"
+    --expert-model-parallel-size "${EP}"
+    --expert-tensor-parallel-size 1
+    --sequence-parallel
+    --context-parallel-size "${CP}"
+    --context-parallel-algo "${CP_TYPE}"
+    --num-layers "${NUM_LAYERS}"
+    --hidden-size 4096
+    --ffn-hidden-size 4096
+    --num-attention-heads 64
+    --tokenizer-type PretrainedFromHF
+    --tokenizer-name-or-path "${TOKENIZER_PATH}"
+    --seq-length "${SEQ_LEN}"
+    --max-position-embeddings 163840
+    --micro-batch-size "${MBS}"
+    --global-batch-size "${GBS}"
+    --make-vocab-size-divisible-by 1
+    --lr "${LR}"
+    --train-iters "${TRAIN_ITERS}"
+    --lr-decay-style cosine
+    --seed "${SEED}"
+    --num-workers "${DATALOADER_WORKERS}"
+    --untie-embeddings-and-output-weights
+    --disable-bias-linear
+    --attention-dropout 0.0
+    --init-method-std 0.02
+    --hidden-dropout 0.0
+    --position-embedding-type deepseek4
+    --normalization RMSNorm
+    --use-fused-swiglu
+    --use-fused-rmsnorm
+    --swiglu
+    --swiglu-limit 10.0
+    --no-masked-softmax-fusion
+    --attention-softmax-in-fp32
+    --min-lr "${MIN_LR}"
+    --weight-decay "${WEIGHT_DECAY}"
+    --lr-warmup-iters "${WARMUP_ITERS}"
+    --clip-grad "${CLIP_GRAD}"
+    --adam-beta1 0.9
+    --adam-beta2 0.999
+    --initial-loss-scale 65536
+    --vocab-size 129280
+    --padded-vocab-size 129280
+    --rotary-base 10000
+    --norm-epsilon 1e-6
+    --bf16
+    --distributed-timeout-minutes 120
+    --no-shared-storage
+    --no-gradient-accumulation-fusion
+)
+
+DATA_ARGS=(
+    --data-path "${DATA_PATH}"
+    --split 100,0,0
+)
+
+OUTPUT_ARGS=(
+    --log-interval 1
+    --save-interval "${SAVE_INTERVAL}"
+    --eval-interval "${SAVE_INTERVAL}"
+    --save "${CKPT_SAVE_DIR}"
+    --load "${CKPT_LOAD_DIR}"
+    --eval-iters 0
+    --ckpt-format torch
+)
+
+# Always save optimizer/RNG state. Only a fresh run resets training progress.
+LOAD_ARGS=(--finetune --no-load-optim --no-load-rng)
+if [[ -n "${RESUME_DIR}" ]]; then
+    LOAD_ARGS=(--lora-load "${RESUME_DIR}" --use-checkpoint-opt_param-scheduler)
+fi
+
+FINETUNE_ARGS=(
+    --stage sft
+    --is-instruction-dataset
+    --handler-name AlpacaStyleInstructionHandler
+    --prompt-type deepseek4
+    --enable-thinking false
+    --lora-r "${LORA_R}"
+    --lora-alpha "${LORA_ALPHA}"
+    --lora-fusion
+    --lora-ckpt-filter
+    --lora-target-modules linear_q linear_kv linear_fc1 linear_fc2 linear_q_up_proj linear_o_down_proj linear_o_up_proj
+)
+
+# Use the 64K no-think indexed data produced by prepare_data.sh.
+# The CP label fix acts at runtime; existing correctly encoded data can be reused.
+echo "64K no-think LoRA: samples=${EXPECTED_SAMPLES}, epochs=${TRAIN_EPOCHS}, steps=${TRAIN_ITERS}, node=${NODE_RANK}"
+"${PYTHON_BIN}" -m torch.distributed.launch "${DISTRIBUTED_ARGS[@]}" posttrain_gpt.py \
+    "${GPT_ARGS[@]}" \
+    "${DATA_ARGS[@]}" \
+    "${OUTPUT_ARGS[@]}" \
+    "${LOAD_ARGS[@]}" \
+    "${MLA_ARGS[@]}" \
+    "${ROPE_ARGS[@]}" \
+    "${MOE_ARGS[@]}" \
+    "${DSA_ARGS[@]}" \
+    "${CA_ARGS[@]}" \
+    "${MEM_ARGS[@]}" \
+    "${FINETUNE_ARGS[@]}" \
+    --distributed-backend nccl 2>&1 | tee "${LOG_FILE}"
