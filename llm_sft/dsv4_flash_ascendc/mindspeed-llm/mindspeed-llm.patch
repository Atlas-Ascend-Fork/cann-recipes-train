index 0000000000000000000000000000000000000000..c6e4e15688fb61ab8dfe8c2516fc12eecf72c7c7
--- /dev/null
+++ b/mindspeed_llm/tasks/preprocess/verify_deepseek4_data.py
@@ -0,0 +1,345 @@
+#!/usr/bin/env python3
+"""Validate exact JSONL -> DeepSeek-V4 MindSpeed LLM SFT conversion."""
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+from transformers import AutoTokenizer
+
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO_ROOT / "3rdparty" / "Megatron-LM"))
+
+from megatron.core.datasets.indexed_dataset import IndexedDataset  # noqa: E402
+
+
+BOS_TOKEN = "<｜begin▁of▁sentence｜>"
+EOS_TOKEN = "<｜end▁of▁sentence｜>"
+USER_TOKEN = "<｜User｜>"
+ASSISTANT_TOKEN = "<｜Assistant｜>"
+THINKING_END = "</think>"
+IGNORE_INDEX = -100
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--raw-data", type=Path, required=True)
+    parser.add_argument("--expected-raw-sha256", required=True)
+    parser.add_argument("--expected-samples", type=int, required=True)
+    parser.add_argument("--tokenizer-path", type=Path, required=True)
+    parser.add_argument("--data-prefix", type=Path)
+    parser.add_argument("--seq-length", type=int, required=True)
+    parser.add_argument("--manifest", type=Path)
+    parser.add_argument(
+        "--preflight-only",
+        action="store_true",
+        help="Report raw token lengths and reject samples that preprocessing would truncate.",
+    )
+    parser.add_argument(
+        "--filter-overlength-to",
+        type=Path,
+        help="With --preflight-only, write an exact JSONL copy excluding over-limit samples.",
+    )
+    args = parser.parse_args()
+    if not args.preflight_only and args.data_prefix is None:
+        parser.error("--data-prefix is required unless --preflight-only is used")
+    if args.filter_overlength_to is not None and not args.preflight_only:
+        parser.error("--filter-overlength-to requires --preflight-only")
+    return args
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def read_raw_rows(path):
+    rows = []
+    with path.open("r", encoding="utf-8") as stream:
+        for line_number, line in enumerate(stream, start=1):
+            if not line.strip():
+                raise ValueError(f"Empty line at {path}:{line_number}")
+            try:
+                row = json.loads(line)
+            except json.JSONDecodeError as error:
+                raise ValueError(f"Invalid JSON at {path}:{line_number}: {error}") from error
+            if not isinstance(row, dict):
+                raise ValueError(f"JSON value must be an object at {path}:{line_number}")
+            if set(row) != {"instruction", "input", "output"}:
+                raise ValueError(f"Unexpected fields at {path}:{line_number}: {sorted(row)}")
+            if not all(isinstance(row[key], str) for key in row):
+                raise ValueError(f"Non-string field at {path}:{line_number}")
+            if not row["input"] or not row["output"]:
+                raise ValueError(f"Empty input/output at {path}:{line_number}")
+            rows.append(row)
+    if not rows:
+        raise ValueError(f"JSONL has no rows: {path}")
+    return rows
+
+
+def artifact_paths(prefix):
+    paths = []
+    for key in ("input_ids", "attention_mask", "labels"):
+        paths.extend(
+            [
+                Path(f"{prefix}_{key}_document.bin"),
+                Path(f"{prefix}_{key}_document.idx"),
+            ]
+        )
+    return paths
+
+
+def encode_expected(row, tokenizer):
+    user_content = "\n".join(part for part in (row["instruction"], row["input"]) if part)
+    prompt_text = BOS_TOKEN + USER_TOKEN + user_content + ASSISTANT_TOKEN + THINKING_END
+    target_text = row["output"] + EOS_TOKEN
+    return (
+        tokenizer.encode(prompt_text, add_special_tokens=False),
+        tokenizer.encode(target_text, add_special_tokens=False),
+    )
+
+
+def write_filtered_raw_data(raw_data, filtered_output, skipped_indices):
+    raw_data = raw_data.resolve()
+    filtered_output = filtered_output.resolve()
+    if raw_data == filtered_output:
+        raise ValueError("Filtered output must be different from the original JSONL")
+    if filtered_output.exists() and not filtered_output.is_file():
+        raise ValueError(f"Filtered output is not a regular file: {filtered_output}")
+
+    filtered_output.parent.mkdir(parents=True, exist_ok=True)
+    descriptor, temporary_name = tempfile.mkstemp(
+        prefix=f".{filtered_output.name}.", suffix=".tmp", dir=filtered_output.parent
+    )
+    temporary = Path(temporary_name)
+    skipped = set(skipped_indices)
+    try:
+        with raw_data.open("rb") as source, os.fdopen(descriptor, "wb") as destination:
+            for index, line in enumerate(source):
+                if index not in skipped:
+                    destination.write(line)
+            destination.flush()
+            os.fsync(destination.fileno())
+
+        if filtered_output.is_file() and sha256_file(filtered_output) == sha256_file(temporary):
+            action = "Reused"
+        else:
+            os.replace(temporary, filtered_output)
+            action = "Wrote"
+        print(f"{action} filtered JSONL: {filtered_output}")
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def scan_raw_token_lengths(rows, tokenizer, seq_length, raw_data=None, filtered_output=None):
+    total_tokens = 0
+    minimum_tokens = None
+    maximum_tokens = 0
+    maximum_row = None
+    over_limit = []
+
+    for index, row in enumerate(rows):
+        prompt_ids, target_ids = encode_expected(row, tokenizer)
+        prompt_length = len(prompt_ids)
+        target_length = len(target_ids)
+        document_length = prompt_length + target_length
+        total_tokens += document_length
+        minimum_tokens = (
+            document_length if minimum_tokens is None else min(minimum_tokens, document_length)
+        )
+        if document_length > maximum_tokens:
+            maximum_tokens = document_length
+            maximum_row = (index, prompt_length, target_length)
+        if document_length >= seq_length:
+            over_limit.append((index, prompt_length, target_length, document_length))
+
+    average_tokens = total_tokens / len(rows)
+    print(
+        "Raw DeepSeek-V4 non-thinking token lengths: "
+        f"documents={len(rows)}, total={total_tokens}, "
+        f"min/avg/max={minimum_tokens}/{average_tokens:.1f}/{maximum_tokens}, "
+        f"seq_length={seq_length}, over_limit={len(over_limit)}"
+    )
+
+    if filtered_output is not None:
+        write_filtered_raw_data(
+            raw_data,
+            filtered_output,
+            (index for index, _, _, _ in over_limit),
+        )
+        print(
+            "Over-length filtering: "
+            f"original={len(rows)}, kept={len(rows) - len(over_limit)}, skipped={len(over_limit)}"
+        )
+    elif over_limit:
+        recommended_seq_length = 1 << maximum_tokens.bit_length()
+        first_rows = ", ".join(
+            f"document {index} (JSONL line {index + 1}): "
+            f"prompt={prompt_length}, assistant={target_length}, total={document_length}"
+            for index, prompt_length, target_length, document_length in over_limit[:10]
+        )
+        if len(over_limit) > 10:
+            first_rows += f", ... and {len(over_limit) - 10} more"
+        max_index, max_prompt, max_target = maximum_row
+        raise ValueError(
